{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semath.dev/schema/domain-pack-v3.json",
  "title": "Semath domain pack schema v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packId",
    "packVersion",
    "packKind",
    "namespace",
    "title",
    "description",
    "dependencies",
    "capabilities",
    "concepts",
    "quantityKinds",
    "units",
    "laws",
    "activationRules",
    "roles",
    "operators",
    "patterns",
    "rewrites",
    "references"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "packId": { "$ref": "#/$defs/id" },
    "packVersion": { "$ref": "#/$defs/version" },
    "packKind": { "enum": ["capability", "field", "application"] },
    "namespace": { "$ref": "#/$defs/id" },
    "title": { "$ref": "#/$defs/text" },
    "description": { "$ref": "#/$defs/text" },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provides", "requires"],
      "properties": {
        "provides": { "$ref": "#/$defs/qualifiedIds" },
        "requires": { "$ref": "#/$defs/qualifiedIds" }
      }
    },
    "concepts": {
      "type": "array",
      "items": { "$ref": "#/$defs/concept" }
    },
    "quantityKinds": {
      "type": "array",
      "items": { "$ref": "#/$defs/quantityKind" }
    },
    "units": {
      "type": "array",
      "items": { "$ref": "#/$defs/unit" }
    },
    "laws": {
      "type": "array",
      "items": { "$ref": "#/$defs/law" }
    },
    "activationRules": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/activationRule" }
    },
    "roles": { "type": "array", "items": { "$ref": "#/$defs/vocabulary" } },
    "operators": { "type": "array", "items": { "$ref": "#/$defs/vocabulary" } },
    "patterns": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/pattern" }
    },
    "rewrites": { "type": "array", "items": { "$ref": "#/$defs/rewrite" } },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/reference" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "qualifiedId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "qualifiedIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/qualifiedId" }
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$"
    },
    "text": { "type": "string", "minLength": 1 },
    "referenceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packId", "versionMajor", "requiredCapabilities"],
      "properties": {
        "packId": { "$ref": "#/$defs/id" },
        "versionMajor": { "type": "integer", "minimum": 0 },
        "requiredCapabilities": { "$ref": "#/$defs/qualifiedIds" }
      }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "conceptKind", "title", "description", "parents", "references"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "conceptKind": { "enum": ["entity", "operator", "quantity", "relation", "system"] },
        "title": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" },
        "parents": { "$ref": "#/$defs/qualifiedIds" },
        "references": { "$ref": "#/$defs/referenceIds" }
      }
    },
    "dimensionExponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "numerator", "denominator"],
      "properties": {
        "base": { "$ref": "#/$defs/id" },
        "numerator": { "type": "integer", "not": { "const": 0 } },
        "denominator": { "type": "integer", "minimum": 1 }
      }
    },
    "dimension": {
      "type": "array",
      "items": { "$ref": "#/$defs/dimensionExponent" }
    },
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": { "type": "integer" },
        "denominator": { "type": "integer", "minimum": 1 }
      }
    },
    "quantityKind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "dimension", "references"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" },
        "dimension": { "$ref": "#/$defs/dimension" },
        "defaultUnit": { "$ref": "#/$defs/qualifiedId" },
        "references": { "$ref": "#/$defs/referenceIds" }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "symbol", "aliases", "dimension", "scale", "references"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "symbol": { "$ref": "#/$defs/text" },
        "aliases": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "dimension": { "$ref": "#/$defs/dimension" },
        "scale": { "$ref": "#/$defs/rational" },
        "offset": { "$ref": "#/$defs/rational" },
        "references": { "$ref": "#/$defs/referenceIds" }
      }
    },
    "lawRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "concept", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "concept": { "$ref": "#/$defs/qualifiedId" },
        "description": { "$ref": "#/$defs/text" }
      }
    },
    "law": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "roles", "conditions", "references"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" },
        "roles": {
          "type": "array",
          "items": { "$ref": "#/$defs/lawRole" }
        },
        "conditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/text" }
        },
        "references": { "$ref": "#/$defs/referenceIds" }
      }
    },
    "activationRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "topic", "patterns", "references"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "topic": { "$ref": "#/$defs/text" },
        "patterns": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
        "references": { "$ref": "#/$defs/referenceIds" }
      }
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "topic", "description", "references"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "topic": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" },
        "notation": { "type": "array", "items": { "type": "string" } },
        "references": { "$ref": "#/$defs/referenceIds" }
      }
    },
    "formulaConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["distribution", "event", "expression", "function", "graph", "index", "matrix", "proposition", "random-variable", "scalar", "set", "tensor", "vector"] },
        "concepts": { "$ref": "#/$defs/qualifiedIds" },
        "dimensions": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "refinements": { "type": "array", "items": { "$ref": "#/$defs/text" } }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "constraint"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "constraint": { "$ref": "#/$defs/formulaConstraint" },
        "optional": { "type": "boolean" }
      }
    },
    "matcher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primitive"],
      "properties": {
        "primitive": { "enum": ["binary-product", "conditional-probability", "event-probability", "expectation", "quadratic-form", "regex-captures", "transpose", "transposed-binary-product", "variance"] },
        "expression": { "type": "string", "maxLength": 512 }
      }
    },
    "relationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter", "role"],
      "properties": {
        "parameter": { "$ref": "#/$defs/id" },
        "role": { "$ref": "#/$defs/id" }
      }
    },
    "patternRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["law", "roleBindings"],
      "properties": {
        "law": { "$ref": "#/$defs/id" },
        "roleBindings": { "type": "array", "items": { "$ref": "#/$defs/relationBinding" } }
      }
    },
    "sideCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "left", "right"],
      "properties": {
        "kind": { "$ref": "#/$defs/id" },
        "left": { "$ref": "#/$defs/text" },
        "right": { "$ref": "#/$defs/text" }
      }
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "topic", "title", "description", "descriptionKey", "maturity", "matcher", "result", "references"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "topic": { "$ref": "#/$defs/text" },
        "title": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" },
        "descriptionKey": { "$ref": "#/$defs/id" },
        "maturity": { "enum": ["recognition", "completion", "diagnostic", "rewrite"] },
        "matcher": { "$ref": "#/$defs/matcher" },
        "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
        "result": { "$ref": "#/$defs/formulaConstraint" },
        "relation": { "$ref": "#/$defs/patternRelation" },
        "sideConditions": { "type": "array", "items": { "$ref": "#/$defs/sideCondition" } },
        "conditionDescriptions": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "generationTemplate": { "$ref": "#/$defs/text" },
        "references": { "$ref": "#/$defs/referenceIds" }
      }
    },
    "requiredRefinement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter", "refinement"],
      "properties": {
        "parameter": { "$ref": "#/$defs/id" },
        "refinement": { "$ref": "#/$defs/id" }
      }
    },
    "rewrite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "topic", "title", "description", "sourcePattern", "requiredRefinements", "replacementTemplate", "references"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "topic": { "$ref": "#/$defs/text" },
        "title": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" },
        "sourcePattern": { "$ref": "#/$defs/id" },
        "requiredRefinements": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/requiredRefinement" } },
        "replacementTemplate": { "$ref": "#/$defs/text" },
        "references": { "$ref": "#/$defs/referenceIds" }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "citation"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "citation": { "$ref": "#/$defs/text" },
        "url": { "type": "string", "format": "uri" }
      }
    }
  }
}
