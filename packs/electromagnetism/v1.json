  "quantityKinds": [],
  "units": [],
  "laws": [
    {
      "id": "electric-force-law",
      "title": "Electric force",
      "description": "Electric force equals charge multiplied by electric field.",
      "roles": [
        {
          "id": "force",
          "concept": "quantities-units:force",
          "description": "Electric force on the charge.",
          "notation": [
            "F"
          ]
        },
        {
          "id": "charge",
          "concept": "quantities-units:electric-charge",
          "description": "Electric charge.",
          "shape": "scalar",
          "notation": [
            "q",
            "Q"
          ]
        },
        {
          "id": "electric-field",
          "concept": "quantities-units:electric-field",
          "description": "Electric field at the charge.",
          "notation": [
            "E"
          ]
        }
      ],
      "semanticForms": [
        "force = charge electric-field",
        "force = charge \\cdot electric-field"
      ],
      "conditions": [
        {
          "id": "electrostatic-regime",
          "kind": "assumption",
          "subjects": [
            "force",
            "charge",
            "electric-field"
          ],
          "label": "The field is evaluated at the charged body and magnetic-force terms are outside this relation."
        }
      ],
      "references": [
        "electrodynamics"
      ]
    },
    {
      "id": "electric-potential-energy",
      "title": "Electric potential energy",
      "description": "Potential energy equals charge multiplied by electric potential.",
      "roles": [
        {
          "id": "energy",
          "concept": "quantities-units:energy",
          "description": "Electric potential energy.",
          "shape": "scalar",
          "notation": [
            "U",
            "W"
          ]
        },
        {
          "id": "charge",
          "concept": "quantities-units:electric-charge",
          "description": "Electric charge.",
          "shape": "scalar",
          "notation": [
            "q",
            "Q"
          ]
        },
        {
          "id": "voltage",
          "concept": "quantities-units:voltage",
          "description": "Electric potential relative to the stated reference.",
          "shape": "scalar",
          "notation": [
            "V",
            "phi"
          ]
        }
      ],
      "semanticForms": [
        "energy = charge voltage",
        "energy = charge \\cdot voltage"
      ],
      "conditions": [
        {
          "id": "common-potential-reference",
          "kind": "same-context",
          "subjects": [
            "energy",
            "charge",
            "voltage"
          ],
          "label": "Charge and potential use the same reference and the electrostatic regime is explicit."
        }
      ],
      "references": [
        "electrodynamics"
      ]
    },
    {
      "id": "electric-power-law",
      "title": "Electric power",
      "description": "Instantaneous electric power equals voltage multiplied by current.",
      "roles": [
        {
          "id": "power",
          "concept": "quantities-units:power",
          "description": "Instantaneous electric power.",
          "shape": "scalar",
          "notation": [
            "P",
            "p"
          ]
        },
        {
          "id": "voltage",
          "concept": "quantities-units:voltage",
          "description": "Terminal voltage.",
          "shape": "scalar",
          "notation": [
            "V",
            "v"
          ]
        },
        {
          "id": "current",
          "concept": "quantities-units:electric-current",
          "description": "Terminal current.",
          "shape": "scalar",
          "notation": [
            "I",
            "i"
          ]
        }
      ],
      "semanticForms": [
        "power = voltage current",
        "power = voltage \\cdot current"
      ],
      "conditions": [
        {
          "id": "consistent-references",
          "kind": "sign-convention",
          "subjects": [
            "voltage",
            "current"
          ],
          "label": "Voltage and current reference directions use one explicitly stated sign convention."
        }
      ],
      "references": [
        "electrodynamics"
      ]
    }
  ],
