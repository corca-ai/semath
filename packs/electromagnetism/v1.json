  "laws": [
    {
      "id": "electric-force-law",
      "title": "Electric force",
      "description": "Electric force equals charge multiplied by electric field.",
      "roles": [
        {
          "id": "force",
          "concept": "quantities-units:force",
          "description": "Electric force on the charge.",
          "notation": [
            "F"
          ]
        },
        {
          "id": "charge",
          "concept": "quantities-units:electric-charge",
          "description": "Electric charge.",
          "shape": "scalar",
          "notation": [
            "q",
            "Q"
          ]
        },
        {
          "id": "electric-field",
          "concept": "quantities-units:electric-field",
          "description": "Electric field at the charge.",
          "notation": [
            "E"
          ]
        }
      ],
      "conditions": [
        {
          "id": "electrostatic-regime",
          "kind": "assumption",
          "subjects": [
            "force",
            "charge",
            "electric-field"
          ],
          "label": "The field is evaluated at the charged body and magnetic-force terms are outside this relation."
        }
      ],
      "references": [
        "electrodynamics"
      ],
      "canonicalRelation": "force = charge electric-field",
      "representations": [
        "force = charge \\cdot electric-field"
      ]
    },
    {
      "id": "electric-potential-energy",
      "title": "Electric potential energy",
      "description": "Potential energy equals charge multiplied by electric potential.",
      "roles": [
        {
          "id": "energy",
          "concept": "quantities-units:energy",
          "description": "Electric potential energy.",
          "shape": "scalar",
          "notation": [
            "U",
            "W"
          ]
        },
        {
          "id": "charge",
          "concept": "quantities-units:electric-charge",
          "description": "Electric charge.",
          "shape": "scalar",
          "notation": [
            "q",
            "Q"
          ]
        },
        {
          "id": "voltage",
          "concept": "quantities-units:voltage",
          "description": "Electric potential relative to the stated reference.",
          "shape": "scalar",
          "notation": [
            "V",
            "phi"
          ]
        }
      ],
      "conditions": [
        {
          "id": "common-potential-reference",
          "kind": "same-context",
          "subjects": [
            "energy",
            "charge",
            "voltage"
          ],
          "label": "Charge and potential use the same reference and the electrostatic regime is explicit."
        }
      ],
      "references": [
        "electrodynamics"
      ],
      "canonicalRelation": "energy = charge voltage",
      "representations": [
        "energy = charge \\cdot voltage"
      ]
    },
    {
      "id": "electric-power-law",
      "title": "Electric power",
      "description": "Instantaneous electric power equals voltage multiplied by current.",
      "roles": [
        {
          "id": "power",
          "concept": "quantities-units:power",
          "description": "Instantaneous electric power.",
          "shape": "scalar",
          "notation": [
            "P",
            "p"
          ]
        },
        {
          "id": "voltage",
          "concept": "quantities-units:voltage",
          "description": "Terminal voltage.",
          "shape": "scalar",
          "notation": [
            "V",
            "v"
          ]
        },
        {
          "id": "current",
          "concept": "quantities-units:electric-current",
          "description": "Terminal current.",
          "shape": "scalar",
          "notation": [
            "I",
            "i"
          ]
        }
      ],
      "conditions": [
        {
          "id": "consistent-references",
          "kind": "sign-convention",
          "subjects": [
            "voltage",
            "current"
          ],
          "label": "Voltage and current reference directions use one explicitly stated sign convention."
        }
      ],
      "references": [
        "electrodynamics"
      ],
      "canonicalRelation": "power = voltage current",
      "representations": [
        "power = voltage \\cdot current"
      ]
    },
    {
      "id": "linear-electric-constitutive-law",
      "title": "Linear electric constitutive law",
      "description": "Electric displacement equals scalar permittivity times electric field.",
      "roles": [
        {
          "id": "displacement",
          "concept": "electromagnetism:electric-displacement",
          "description": "Electric displacement vector.",
          "shape": "vector"
        },
        {
          "id": "permittivity",
          "concept": "electromagnetism:permittivity",
          "description": "Scalar permittivity.",
          "shape": "scalar"
        },
        {
          "id": "electric-field",
          "concept": "quantities-units:electric-field",
          "description": "Electric-field vector.",
          "shape": "vector"
        }
      ],
      "conditions": [
        {
          "id": "declared-domain",
          "kind": "domain-membership",
          "subjects": [
            "displacement",
            "permittivity",
            "electric-field"
          ],
          "label": "Every role is explicitly bound to its declared semantic domain."
        }
      ],
      "references": [
        "electrodynamics"
      ],
      "canonicalRelation": "displacement = permittivity electric-field"
    },
    {
      "id": "electromagnetic-wave-speed",
      "title": "Electromagnetic wave speed",
      "description": "Wave speed is the reciprocal of the positive medium factor.",
      "roles": [
        {
          "id": "wave-speed",
          "concept": "quantities-units:velocity",
          "description": "Wave speed.",
          "shape": "scalar"
        },
        {
          "id": "medium-factor",
          "concept": "electromagnetism:medium-factor",
          "description": "Positive medium factor.",
          "shape": "scalar"
        }
      ],
      "conditions": [
        {
          "id": "declared-domain",
          "kind": "domain-membership",
          "subjects": [
            "wave-speed",
            "medium-factor"
          ],
          "label": "Every role is explicitly bound to its declared semantic domain."
        }
      ],
      "references": [
        "electrodynamics"
      ],
      "canonicalRelation": "wave-speed = 1 / medium-factor"
    },
    {
      "id": "gauss-electric",
      "title": "Gauss electric law",
      "description": "The divergence of electric field equals charge density divided by permittivity in differential form.",
      "roles": [
        {
          "id": "electric-field",
          "concept": "quantities-units:electric-field",
          "description": "Electric field."
        },
        {
          "id": "charge-density",
          "concept": "electromagnetism:charge-density",
          "description": "Charge density.",
          "shape": "scalar"
        },
        {
          "id": "permittivity",
          "concept": "electromagnetism:permittivity",
          "description": "Permittivity.",
          "shape": "scalar"
        }
      ],
      "conditions": [
        {
          "id": "declared-field-model",
          "kind": "domain-membership",
          "subjects": [
            "electric-field",
            "charge-density",
            "permittivity"
          ],
          "label": "The field and material quantities are explicitly bound to one electromagnetic model."
        }
      ],
      "activationPhrases": [
        "Gauss's law"
      ],
      "references": [
        "electrodynamics"
      ],
      "canonicalRelation": "\\nabla \\cdot electric-field = charge-density / permittivity"
    },
    {
      "id": "faraday-law",
      "title": "Faraday induction law",
      "description": "The curl of electric field equals the negative time derivative of magnetic flux density.",
      "roles": [
        {
          "id": "electric-field",
          "concept": "quantities-units:electric-field",
          "description": "Electric field."
        },
        {
          "id": "magnetic-field",
          "concept": "electromagnetism:magnetic-field",
          "description": "Magnetic flux density."
        },
        {
          "id": "time",
          "concept": "quantities-units:duration",
          "description": "Time."
        }
      ],
      "conditions": [
        {
          "id": "declared-field-model",
          "kind": "domain-membership",
          "subjects": [
            "electric-field",
            "magnetic-field",
            "time"
          ],
          "label": "Both fields and the independent time variable belong to the same model."
        }
      ],
      "activationPhrases": [
        "Faraday's law"
      ],
      "references": [
        "electrodynamics"
      ],
      "canonicalRelation": "\\nabla \\times electric-field = -\\frac{\\partial magnetic-field}{\\partial time}"
    },
    {
      "id": "scalar-wave-equation",
      "title": "Scalar wave equation",
      "description": "A homogeneous scalar wave field has Laplacian equal to inverse-speed-squared times its second time derivative.",
      "roles": [
        {
          "id": "field",
          "concept": "electromagnetism:scalar-field",
          "description": "Scalar wave field."
        },
        {
          "id": "speed",
          "concept": "quantities-units:velocity",
          "description": "Wave speed.",
          "shape": "scalar"
        },
        {
          "id": "time",
          "concept": "quantities-units:duration",
          "description": "Time."
        }
      ],
      "conditions": [
        {
          "id": "homogeneous-medium",
          "kind": "domain-membership",
          "subjects": [
            "field",
            "speed",
            "time"
          ],
          "label": "The field, speed, and independent time variable are explicitly bound to one homogeneous wave model."
        }
      ],
      "activationPhrases": [
        "homogeneous wave equation",
        "scalar wave equation"
      ],
      "references": [
        "electrodynamics"
      ],
      "canonicalRelation": "\\nabla^2 field = \\frac{1}{speed^2} \\frac{\\partial^2 field}{\\partial time^2}"
    },
    {
      "id": "helmholtz-equation",
      "title": "Helmholtz equation",
      "description": "A time-harmonic scalar field satisfies a Laplacian plus wave-number-squared relation.",
      "roles": [
        {
          "id": "field",
          "concept": "electromagnetism:scalar-field",
          "description": "Time-harmonic scalar field."
        },
        {
          "id": "wave-number",
          "concept": "electromagnetism:wave-number",
          "description": "Wave number.",
          "shape": "scalar"
        }
      ],
      "conditions": [
        {
          "id": "time-harmonic-model",
          "kind": "domain-membership",
          "subjects": [
            "field",
            "wave-number"
          ],
          "label": "The field and wave number are explicitly bound to the same time-harmonic model."
        }
      ],
      "activationPhrases": [
        "Helmholtz equation"
      ],
      "references": [
        "electrodynamics"
      ],
      "canonicalRelation": "\\nabla^2 field + wave-number^2 field = 0"
    }
  ],
