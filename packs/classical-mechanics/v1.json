    }
  ],
  "quantityKinds": [],
  "units": [],
  "laws": [
    {
      "id": "newton-second-law",
      "title": "Newton's second law",
      "description": "The net force on a body equals its inertial mass multiplied by its acceleration.",
      "roles": [
        {
          "id": "net-force",
          "concept": "quantities-units:force",
          "description": "Net force acting on the body.",
          "notation": ["F"]
        },
        {
          "id": "mass",
          "concept": "quantities-units:mass",
          "description": "Inertial mass of the body.",
          "shape": "scalar",
          "notation": ["m"]
        },
        {
          "id": "acceleration",
          "concept": "quantities-units:acceleration",
          "description": "Acceleration in the active inertial frame.",
          "notation": ["a"]
        }
      ],
      "semanticForms": [
        "net-force = mass acceleration",
        "net-force = mass \\cdot acceleration"
      ],
      "conditions": [
        "The quantities refer to one body in a common inertial frame."
      ],
      "references": [
        "classical-mechanics"
      ]
    },
    {
      "id": "kinetic-energy-definition",
      "title": "Kinetic energy",
      "description": "Translational kinetic energy equals one half mass times speed squared.",
      "roles": [
        {
          "id": "energy",
          "concept": "quantities-units:energy",
          "description": "Kinetic energy.",
          "shape": "scalar",
          "notation": ["K", "E", "T"]
        },
        {
          "id": "mass",
          "concept": "quantities-units:mass",
          "description": "Inertial mass.",
          "shape": "scalar",
          "notation": ["m"]
        },
        {
          "id": "velocity",
          "concept": "quantities-units:velocity",
          "description": "Body velocity.",
          "notation": ["v"]
        }
      ],
      "semanticForms": [
        "energy = \\frac{1}{2} mass velocity^2",
        "energy = \\frac{1}{2} mass \\cdot velocity^2",
        "energy = \\frac{1}{2} mass \\lVert velocity \\rVert^2"
      ],
      "conditions": [
        "The expression uses nonrelativistic translational motion."
      ],
      "references": [
        "classical-mechanics"
      ]
    },
    {
      "id": "mechanical-power",
      "title": "Mechanical power",
      "description": "Instantaneous power equals force dotted with velocity.",
      "roles": [
        {
          "id": "power",
          "concept": "quantities-units:power",
          "description": "Instantaneous power.",
          "shape": "scalar",
          "notation": ["P"]
        },
        {
          "id": "force",
          "concept": "quantities-units:force",
          "description": "Applied force.",
          "notation": ["F"]
        },
        {
          "id": "velocity",
          "concept": "quantities-units:velocity",
          "description": "Point velocity.",
          "notation": ["v"]
        }
      ],
      "semanticForms": [
        "power = force \\cdot velocity",
        "power = force velocity"
      ],
      "conditions": [
        "Force and velocity components use one coordinate frame."
      ],
      "references": [
        "classical-mechanics"
      ]
    }
  ],
