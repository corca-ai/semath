      "id": "newton-second-law",
      "title": "Newton's second law",
      "description": "The net force on a body equals its inertial mass multiplied by its acceleration.",
      "roles": [
        { "id": "net-force", "concept": "quantities-units:force", "description": "Net force acting on the body." },
        { "id": "mass", "concept": "quantities-units:mass", "description": "Inertial mass of the body." },
        { "id": "acceleration", "concept": "quantities-units:acceleration", "description": "Acceleration in the active inertial frame." }
      ],
      "conditions": ["The quantities refer to one body in a common inertial frame."],
      "references": ["classical-mechanics"]
    },
    { "id": "momentum-definition", "title": "Linear momentum", "description": "Linear momentum equals mass times velocity.", "roles": [{ "id": "momentum", "concept": "quantities-units:momentum", "description": "Linear momentum." }, { "id": "mass", "concept": "quantities-units:mass", "description": "Inertial mass." }, { "id": "velocity", "concept": "quantities-units:velocity", "description": "Body velocity." }], "conditions": ["All quantities describe the same body and frame."], "references": ["classical-mechanics"] },
    { "id": "kinetic-energy-definition", "title": "Kinetic energy", "description": "Translational kinetic energy equals one half mass times speed squared.", "roles": [{ "id": "energy", "concept": "quantities-units:energy", "description": "Kinetic energy." }, { "id": "mass", "concept": "quantities-units:mass", "description": "Inertial mass." }, { "id": "velocity", "concept": "quantities-units:velocity", "description": "Body velocity." }], "conditions": ["The expression uses nonrelativistic translational motion."], "references": ["classical-mechanics"] },
    { "id": "gravitational-potential-energy", "title": "Uniform-field potential energy", "description": "Potential energy near a uniform field equals mass times gravitational acceleration and height.", "roles": [{ "id": "energy", "concept": "quantities-units:energy", "description": "Potential energy." }, { "id": "mass", "concept": "quantities-units:mass", "description": "Mass." }, { "id": "acceleration", "concept": "quantities-units:acceleration", "description": "Uniform gravitational acceleration." }, { "id": "height", "concept": "quantities-units:length", "description": "Height relative to the reference." }], "conditions": ["The gravitational field is treated as uniform."], "references": ["classical-mechanics"] },
    { "id": "hooke-law", "title": "Hooke's law", "description": "Spring restoring force equals negative stiffness times displacement.", "roles": [{ "id": "force", "concept": "quantities-units:force", "description": "Restoring force." }, { "id": "stiffness", "concept": "quantities-units:stiffness", "description": "Spring stiffness." }, { "id": "displacement", "concept": "quantities-units:length", "description": "Displacement from equilibrium." }], "conditions": ["The spring is in its calibrated linear regime."], "references": ["classical-mechanics"] },
    { "id": "viscous-damping-law", "title": "Viscous damping", "description": "Damping force equals negative damping coefficient times velocity.", "roles": [{ "id": "force", "concept": "quantities-units:force", "description": "Damping force." }, { "id": "coefficient", "concept": "quantities-units:damping-coefficient", "description": "Viscous damping coefficient." }, { "id": "velocity", "concept": "quantities-units:velocity", "description": "Relative velocity." }], "conditions": ["The damping model is linear and viscous."], "references": ["classical-mechanics"] },
    { "id": "mechanical-power", "title": "Mechanical power", "description": "Instantaneous power equals force dotted with velocity.", "roles": [{ "id": "power", "concept": "quantities-units:power", "description": "Instantaneous power." }, { "id": "force", "concept": "quantities-units:force", "description": "Applied force." }, { "id": "velocity", "concept": "quantities-units:velocity", "description": "Point velocity." }], "conditions": ["Force and velocity components use one coordinate frame."], "references": ["classical-mechanics"] },
    { "id": "centripetal-acceleration", "title": "Centripetal acceleration", "description": "Centripetal acceleration magnitude equals speed squared divided by radius.", "roles": [{ "id": "acceleration", "concept": "quantities-units:acceleration", "description": "Centripetal acceleration." }, { "id": "velocity", "concept": "quantities-units:velocity", "description": "Tangential velocity." }, { "id": "radius", "concept": "quantities-units:length", "description": "Path radius." }], "conditions": ["The motion is locally circular."], "references": ["classical-mechanics"] }
  ],
