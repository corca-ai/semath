          "description": "The circle constant pi.",
          "shape": "scalar",
          "notation": [
            "pi"
          ]
        },
        {
          "id": "frequency",
          "concept": "signals-systems:cyclic-frequency",
          "quantity": "quantities-units:frequency",
          "description": "Cyclic frequency.",
          "shape": "scalar",
          "notation": [
            "f",
            "nu"
          ]
        }
      ],
      "conditions": [
        {
          "id": "common-oscillation",
          "kind": "same-context",
          "subjects": [
            "angular-frequency",
            "frequency"
          ],
          "evidencePhrases": [
            "same oscillation",
            "same oscillator",
            "share one estimate"
          ],
          "label": "Frequency and angular frequency describe the same oscillation."
        }
      ],
      "references": [
        "signals-systems"
      ],
      "canonicalRelation": "angular-frequency = 2 pi frequency"
    },
    {
