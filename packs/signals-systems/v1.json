      "id": "period-frequency-reciprocity",
      "title": "Period-frequency reciprocity",
      "description": "Frequency is the reciprocal of period.",
      "roles": [
        {
          "id": "frequency",
          "concept": "signals-systems:cyclic-frequency",
          "quantity": "quantities-units:frequency",
          "description": "Cyclic frequency.",
          "shape": "scalar",
          "notation": [
            "f",
            "nu"
          ]
        },
        {
          "id": "period",
          "concept": "quantities-units:duration",
          "description": "Signal period.",
          "shape": "scalar",
          "notation": [
            "T",
            "P",
            "tau"
          ]
        }
      ],
      "conditions": [
        {
          "id": "positive-period",
          "kind": "positive",
          "subjects": [
            "period"
          ],
          "evidencePhrases": [
            "measured period",
            "positive period"
          ],
          "label": "The period is positive."
        },
        {
          "id": "common-periodic-signal",
          "kind": "same-context",
          "subjects": [
            "frequency",
            "period"
          ],
          "evidencePhrases": [
            "oscillator period",
            "same periodic signal",
            "same oscillator",
            "share one estimate"
          ],
          "label": "Frequency and period refer to the same periodic signal."
        }
      ],
      "references": [
        "signals-systems"
      ],
      "archetype": {
        "id": "reciprocal",
        "slots": {
          "result": "frequency",
          "denominator": "period"
        }
      },
      "representations": [
        "period = 1 / frequency"
      ]
    },
    {
      "id": "angular-frequency-definition",
      "title": "Angular frequency",
      "description": "Angular frequency equals two pi times cyclic frequency.",
