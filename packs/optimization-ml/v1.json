  "packKind": "field",
  "namespace": "optimization-ml",
  "title": "Optimization and machine learning",
  "description": "Recognition-first catalog for objectives, constraints, and learning updates without inferred convexity or optimality.",
  "dependencies": [],
  "capabilities": { "provides": ["semath:formula-recognition"], "requires": [] },
  "concepts": [
    { "id": "objective-function", "conceptKind": "entity", "title": "Objective function", "description": "A function optimized over an explicitly declared variable.", "parents": [], "references": ["convex-optimization"] },
    { "id": "argmin", "conceptKind": "operator", "title": "Argmin", "description": "An operator denoting minimizers of an objective.", "parents": [], "references": ["convex-optimization"] }
  ],
  "quantityKinds": [],
