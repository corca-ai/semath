      "description": "The gradient of a differentiable unconstrained objective vanishes at a stationary point.",
      "roles": [
        {
          "id": "objective",
          "concept": "optimization-ml:objective-function",
          "description": "Differentiable objective function."
        },
        {
          "id": "variable",
          "concept": "optimization-ml:iterate",
          "description": "Unconstrained optimum.",
          "shape": "vector"
        }
      ],
      "conditions": [
        {
          "id": "differentiable-objective",
          "kind": "differentiable",
          "subjects": [
            "objective",
            "variable"
          ],
          "label": "The objective is differentiable at an unconstrained interior point."
        }
      ],
      "activationPhrases": [
        "first-order stationarity"
      ],
      "references": [
        "convex-optimization"
      ],
      "canonicalRelation": "\\nabla objective(variable) = 0"
    },
    {
