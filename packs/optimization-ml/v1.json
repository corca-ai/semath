        {
          "id": "loss",
          "concept": "optimization-ml:loss-value",
          "description": "Binary cross-entropy loss.",
          "shape": "scalar",
          "notation": [
            "L",
            "ell"
          ]
        },
        {
          "id": "label",
          "concept": "optimization-ml:binary-label",
          "description": "Binary label.",
          "shape": "scalar",
          "notation": [
            "y"
          ]
        },
        {
          "id": "probability",
          "concept": "optimization-ml:predicted-probability",
          "description": "Predicted probability.",
          "shape": "scalar",
          "notation": [
            "p",
            "q"
          ]
        }
      ],
      "conditions": [
        {
          "id": "probability-domain",
          "kind": "domain-membership",
          "subjects": [
            "label",
            "probability"
          ],
