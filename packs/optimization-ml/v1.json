          "concept": "optimization-ml:loss-value",
          "description": "Data-fit loss.",
          "shape": "scalar"
        },
        {
          "id": "weight",
          "concept": "optimization-ml:step-size",
          "description": "Regularization weight.",
          "shape": "scalar"
        },
        {
          "id": "penalty",
          "concept": "optimization-ml:penalty-value",
          "description": "Penalty value.",
          "shape": "scalar"
