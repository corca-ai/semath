          "concept": "linear-algebra:vector",
          "description": "Observation vector.",
          "shape": "vector"
        }
      ],
      "conditions": [
        {
          "id": "compatible-shapes",
          "kind": "shape-compatible",
          "subjects": [
            "design",
            "parameter",
            "observation"
          ],
          "label": "The design, parameter, and observation dimensions are compatible."
        }
      ],
      "activationPhrases": [
        "normal equation"
      ],
      "references": [
