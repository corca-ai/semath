    {
      "id": "gradient-descent-update",
      "title": "Gradient descent update",
      "description": "The next iterate is the current iterate minus a scalar step times the objective gradient.",
      "roles": [
        {
          "id": "next",
          "concept": "optimization-ml:iterate",
          "description": "Next iterate.",
          "shape": "vector",
          "notation": [
            "xnext",
            "y",
            "z"
          ]
        },
        {
          "id": "current",
          "concept": "optimization-ml:iterate",
          "description": "Current iterate.",
          "shape": "vector",
          "notation": [
            "x",
            "ycurrent",
            "w"
          ]
        },
        {
          "id": "step",
          "concept": "optimization-ml:step-size",
          "description": "Scalar step size.",
          "shape": "scalar",
          "notation": [
            "alpha",
            "eta",
            "gamma"
          ]
        },
        {
          "id": "gradient",
          "concept": "optimization-ml:gradient",
          "description": "Objective gradient.",
          "shape": "vector",
          "notation": [
            "g",
            "d",
            "nabla"
          ]
        }
      ],
      "conditions": [
        {
          "id": "compatible-shapes",
          "kind": "shape-compatible",
          "subjects": [
            "next",
            "current",
            "step",
            "gradient"
          ],
          "label": "The gradient and iterates share a vector space and the step size is scalar."
        }
      ],
      "references": [
        "convex-optimization"
      ],
      "canonicalRelation": "next = current - step gradient"
    },
