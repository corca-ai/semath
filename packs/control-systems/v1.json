      ],
      "conditions": [
        {
          "id": "compatible-square-shapes",
          "kind": "shape-compatible",
          "subjects": [
            "state-matrix",
            "certificate",
            "forcing"
          ],
          "label": "All matrices are declared square with a common dimension."
        }
      ],
      "references": [
        "linear-system-theory"
      ],
      "canonicalRelation": "state-matrix^T certificate + certificate state-matrix = -forcing",
      "representations": [
        "state-matrix' certificate + certificate state-matrix = -forcing",
        "0 = state-matrix^T certificate + certificate state-matrix + forcing",
        "forcing = -(state-matrix^T certificate + certificate state-matrix)"
      ]
    },
