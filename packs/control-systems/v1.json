  "patterns": [
    {
      "id": "discrete-state-transition",
      "topic": "state-space",
      "title": "Discrete-time state equation",
      "description": "Linear discrete state update with explicitly declared vector and matrix shapes.",
      "descriptionKey": "discrete-state-transition",
      "maturity": "recognition",
      "matcher": { "primitive": "regex-captures", "expression": "^([A-Za-z])\\s*_\\s*\\{?([^{}]+)\\}?\\s*=\\s*([A-Za-z])\\s*([A-Za-z])\\s*_\\s*\\{?([^{}]+)\\}?\\s*\\+\\s*([A-Za-z])\\s*([A-Za-z])\\s*_\\s*\\{?([^{}]+)\\}?$" },
      "parameters": [
        { "id": "next-state", "constraint": { "kind": "vector", "dimensions": ["n"] } },
        { "id": "next-index", "constraint": { "kind": "expression" } },
        { "id": "state-matrix", "constraint": { "kind": "matrix", "dimensions": ["n", "n"] } },
        { "id": "current-state", "constraint": { "kind": "vector", "dimensions": ["n"] } },
        { "id": "current-index", "constraint": { "kind": "expression" } },
        { "id": "input-matrix", "constraint": { "kind": "matrix", "dimensions": ["n", "m"] } },
        { "id": "control-input", "constraint": { "kind": "vector", "dimensions": ["m"] } },
        { "id": "input-index", "constraint": { "kind": "expression" } }
      ],
      "result": { "kind": "proposition", "refinements": ["state-transition"] },
      "relation": { "law": "discrete-state-transition", "roleBindings": [{ "parameter": "next-state", "role": "next-state" }, { "parameter": "state-matrix", "role": "state-matrix" }, { "parameter": "current-state", "role": "current-state" }, { "parameter": "input-matrix", "role": "input-matrix" }, { "parameter": "control-input", "role": "control-input" }] },
      "references": ["linear-system-theory"]
    },
    { "id": "continuous-state-equation", "topic": "state-space", "title": "Continuous-time state equation", "description": "Continuous linear state dynamics with explicit vector and matrix shapes.", "descriptionKey": "continuous-state-equation", "maturity": "recognition", "matcher": { "primitive": "regex-captures", "expression": "^\\\\dot\\s*\\{?([A-Za-z])\\}?\\s*=\\s*([A-Za-z])\\s*([A-Za-z])\\s*\\+\\s*([A-Za-z])\\s*([A-Za-z])$" }, "parameters": [{ "id": "derivative-state", "constraint": { "kind": "vector", "dimensions": ["n"] } }, { "id": "state-matrix", "constraint": { "kind": "matrix", "dimensions": ["n", "n"] } }, { "id": "state", "constraint": { "kind": "vector", "dimensions": ["n"] } }, { "id": "input-matrix", "constraint": { "kind": "matrix", "dimensions": ["n", "m"] } }, { "id": "control-input", "constraint": { "kind": "vector", "dimensions": ["m"] } }], "result": { "kind": "proposition", "refinements": ["state-transition"] }, "relation": { "law": "continuous-state-equation", "roleBindings": [{ "parameter": "state", "role": "state" }, { "parameter": "state-matrix", "role": "state-matrix" }, { "parameter": "input-matrix", "role": "input-matrix" }, { "parameter": "control-input", "role": "control-input" }] }, "references": ["linear-system-theory"] },
    { "id": "state-space-output", "topic": "state-space", "title": "State-space output equation", "description": "Linear state-space output with explicit vector and matrix shapes.", "descriptionKey": "state-space-output", "maturity": "recognition", "matcher": { "primitive": "regex-captures", "expression": "^([A-Za-z])\\s*=\\s*([A-Za-z])\\s*([A-Za-z])\\s*\\+\\s*([A-Za-z])\\s*([A-Za-z])$" }, "parameters": [{ "id": "output", "constraint": { "kind": "vector", "dimensions": ["p"] } }, { "id": "output-matrix", "constraint": { "kind": "matrix", "dimensions": ["p", "n"] } }, { "id": "state", "constraint": { "kind": "vector", "dimensions": ["n"] } }, { "id": "feedthrough-matrix", "constraint": { "kind": "matrix", "dimensions": ["p", "m"] } }, { "id": "control-input", "constraint": { "kind": "vector", "dimensions": ["m"] } }], "result": { "kind": "proposition", "refinements": ["state-observation"] }, "relation": { "law": "output-equation", "roleBindings": [{ "parameter": "output", "role": "output" }, { "parameter": "output-matrix", "role": "output-matrix" }, { "parameter": "state", "role": "state" }, { "parameter": "feedthrough-matrix", "role": "feedthrough-matrix" }, { "parameter": "control-input", "role": "control-input" }] }, "references": ["linear-system-theory"] },
    { "id": "negative-state-feedback", "topic": "feedback", "title": "Negative state feedback", "description": "State-feedback law with explicit compatible shapes.", "descriptionKey": "negative-state-feedback", "maturity": "recognition", "matcher": { "primitive": "regex-captures", "expression": "^([A-Za-z])\\s*=\\s*-\\s*([A-Za-z])\\s*([A-Za-z])\\s*\\+\\s*([A-Za-z])$" }, "parameters": [{ "id": "control-input", "constraint": { "kind": "vector", "dimensions": ["m"] } }, { "id": "feedback-gain", "constraint": { "kind": "matrix", "dimensions": ["m", "n"] } }, { "id": "state", "constraint": { "kind": "vector", "dimensions": ["n"] } }, { "id": "reference", "constraint": { "kind": "vector", "dimensions": ["m"] } }], "result": { "kind": "proposition", "refinements": ["feedback-law"] }, "relation": { "law": "state-feedback", "roleBindings": [{ "parameter": "control-input", "role": "control-input" }, { "parameter": "feedback-gain", "role": "feedback-gain" }, { "parameter": "state", "role": "state" }, { "parameter": "reference", "role": "reference" }] }, "references": ["linear-system-theory"] },
    { "id": "closed-loop-state-matrix", "topic": "feedback", "title": "Closed-loop state matrix", "description": "Closed-loop matrix construction with explicit compatible shapes.", "descriptionKey": "closed-loop-state-matrix", "maturity": "recognition", "matcher": { "primitive": "regex-captures", "expression": "^([A-Za-z])\\s*_\\s*\\{?[A-Za-z]+\\}?\\s*=\\s*([A-Za-z])\\s*-\\s*([A-Za-z])\\s*([A-Za-z])$" }, "parameters": [{ "id": "closed-loop-matrix", "constraint": { "kind": "matrix", "dimensions": ["n", "n"] } }, { "id": "state-matrix", "constraint": { "kind": "matrix", "dimensions": ["n", "n"] } }, { "id": "input-matrix", "constraint": { "kind": "matrix", "dimensions": ["n", "m"] } }, { "id": "feedback-gain", "constraint": { "kind": "matrix", "dimensions": ["m", "n"] } }], "result": { "kind": "proposition", "refinements": ["closed-loop-model"] }, "relation": { "law": "closed-loop-state-matrix", "roleBindings": [{ "parameter": "closed-loop-matrix", "role": "closed-loop-matrix" }, { "parameter": "state-matrix", "role": "state-matrix" }, { "parameter": "input-matrix", "role": "input-matrix" }, { "parameter": "feedback-gain", "role": "feedback-gain" }] }, "references": ["linear-system-theory"] },
    { "id": "continuous-lyapunov-equation", "topic": "stability", "title": "Continuous Lyapunov equation", "description": "Continuous Lyapunov equation with common declared square shape.", "descriptionKey": "continuous-lyapunov-equation", "maturity": "recognition", "matcher": { "primitive": "regex-captures", "expression": "^([A-Za-z])\\s*\\^\\s*\\{?T\\}?\\s*([A-Za-z])\\s*\\+\\s*([A-Za-z])\\s*([A-Za-z])\\s*=\\s*-\\s*([A-Za-z])$" }, "parameters": [{ "id": "left-state-matrix", "constraint": { "kind": "matrix", "dimensions": ["n", "n"] } }, { "id": "left-certificate", "constraint": { "kind": "matrix", "dimensions": ["n", "n"] } }, { "id": "right-certificate", "constraint": { "kind": "matrix", "dimensions": ["n", "n"] } }, { "id": "right-state-matrix", "constraint": { "kind": "matrix", "dimensions": ["n", "n"] } }, { "id": "forcing", "constraint": { "kind": "matrix", "dimensions": ["n", "n"] } }], "result": { "kind": "proposition", "refinements": ["stability-certificate-equation"] }, "relation": { "law": "continuous-lyapunov-equation", "roleBindings": [{ "parameter": "left-state-matrix", "role": "state-matrix" }, { "parameter": "left-certificate", "role": "certificate" }, { "parameter": "forcing", "role": "forcing" }] }, "references": ["linear-system-theory"] },
    { "id": "discrete-lyapunov-equation", "topic": "stability", "title": "Discrete Lyapunov equation", "description": "Discrete Lyapunov equation with common declared square shape.", "descriptionKey": "discrete-lyapunov-equation", "maturity": "recognition", "matcher": { "primitive": "regex-captures", "expression": "^([A-Za-z])\\s*\\^\\s*\\{?T\\}?\\s*([A-Za-z])\\s*([A-Za-z])\\s*-\\s*([A-Za-z])\\s*=\\s*-\\s*([A-Za-z])$" }, "parameters": [{ "id": "left-state-matrix", "constraint": { "kind": "matrix", "dimensions": ["n", "n"] } }, { "id": "certificate", "constraint": { "kind": "matrix", "dimensions": ["n", "n"] } }, { "id": "right-state-matrix", "constraint": { "kind": "matrix", "dimensions": ["n", "n"] } }, { "id": "subtracted-certificate", "constraint": { "kind": "matrix", "dimensions": ["n", "n"] } }, { "id": "forcing", "constraint": { "kind": "matrix", "dimensions": ["n", "n"] } }], "result": { "kind": "proposition", "refinements": ["stability-certificate-equation"] }, "relation": { "law": "discrete-lyapunov-equation", "roleBindings": [{ "parameter": "left-state-matrix", "role": "state-matrix" }, { "parameter": "certificate", "role": "certificate" }, { "parameter": "forcing", "role": "forcing" }] }, "references": ["linear-system-theory"] }
  ],
