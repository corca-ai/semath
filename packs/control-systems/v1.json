{
  "schemaVersion": 4,
  "packId": "control-systems",
  "packVersion": "1.0.0",
  "packKind": "field",
  "namespace": "control-systems",
  "title": "Control systems",
  "description": "State, input, and system-relation semantics gated by explicit vector and matrix declarations.",
  "dependencies": [
    {
      "packId": "linear-algebra",
      "versionMajor": 1,
      "requiredCapabilities": [
        "semath:shape-analysis"
      ]
    }
  ],
  "capabilities": {
    "provides": [
      "control-systems:law-relations",
      "semath:formula-recognition"
    ],
    "requires": [
      "semath:shape-analysis"
    ]
  },
  "concepts": [
    {
      "id": "state",
      "conceptKind": "entity",
      "title": "System state",
      "description": "A state vector summarizing the information needed for future evolution.",
      "parents": [],
      "references": [
        "linear-system-theory"
      ]
    },
    {
      "id": "control-input",
      "conceptKind": "entity",
      "title": "Control input",
      "description": "An externally selected input to a dynamical system.",
      "parents": [],
      "references": [
        "linear-system-theory"
      ]
    },
    {
      "id": "state-transition",
      "conceptKind": "relation",
      "title": "Discrete state transition",
      "description": "A discrete-time linear state update.",
      "parents": [],
      "references": [
        "linear-system-theory"
      ]
    },
    {
      "id": "state-matrix",
      "conceptKind": "entity",
      "title": "State matrix",
      "description": "The linear operator multiplying the state.",
      "parents": [],
      "references": ["linear-system-theory"]
    },
    {
      "id": "input-matrix",
      "conceptKind": "entity",
      "title": "Input matrix",
      "description": "The linear operator multiplying the control input.",
      "parents": [],
      "references": ["linear-system-theory"]
    },
    {
      "id": "lyapunov-certificate",
      "conceptKind": "entity",
      "title": "Lyapunov certificate",
      "description": "The matrix defining a quadratic Lyapunov function.",
      "parents": [],
      "references": ["linear-system-theory"]
    },
    {
      "id": "forcing-matrix",
      "conceptKind": "entity",
      "title": "Lyapunov forcing matrix",
      "description": "The forcing matrix in a continuous Lyapunov equation.",
      "parents": [],
      "references": ["linear-system-theory"]
    }
  ],
  "quantityKinds": [],
  "units": [],
  "laws": [
    {
      "id": "continuous-state-equation",
      "title": "Continuous-time state equation",
      "description": "The state derivative equals autonomous dynamics plus the input contribution.",
      "roles": [
        {
        "id": "state",
        "concept": "control-systems:state",
          "description": "State vector and its derivative.",
          "shape": "vector",
          "notation": ["x", "z", "q", "s", "y", "xi", "chi", "rho", "omega", "p", "a", "h", "theta", "zeta", "X"]
        },
        {
        "id": "state-matrix",
          "concept": "control-systems:state-matrix",
          "description": "State matrix.",
          "shape": "matrix",
          "notation": ["A", "F", "M", "K", "C", "H", "R", "U", "E", "B", "D", "G", "L"]
        },
        {
        "id": "input-matrix",
          "concept": "control-systems:input-matrix",
          "description": "Input matrix.",
          "shape": "matrix",
          "notation": ["B", "G", "N", "L", "D", "J", "S", "V", "F", "A", "C", "H", "K", "R"]
        },
        {
        "id": "control-input",
        "concept": "control-systems:control-input",
          "description": "Control input.",
          "shape": "vector",
          "notation": ["u", "v", "w", "r", "e", "eta", "nu", "sigma", "tau", "c", "b", "j", "mu", "upsilon", "U"]
        }
      ],
      "semanticForms": [
        "\\dot{state} = state-matrix state + input-matrix control-input"
      ],
      "conditions": [
        "All declared dimensions are compatible."
      ],
      "references": [
        "linear-system-theory"
      ]
    },
    {
      "id": "continuous-lyapunov-equation",
      "title": "Continuous Lyapunov equation",
      "description": "A transpose-weighted matrix sum equals a negative definite forcing matrix.",
      "roles": [
        {
        "id": "state-matrix",
          "concept": "control-systems:state-matrix",
          "description": "State matrix.",
          "shape": "matrix",
          "notation": ["A", "F", "M", "K", "C", "B", "D", "E", "G", "L"]
        },
        {
        "id": "certificate",
          "concept": "control-systems:lyapunov-certificate",
          "description": "Lyapunov matrix.",
          "shape": "matrix",
          "notation": ["P", "X", "H", "Y", "Z", "J", "L"]
        },
        {
        "id": "forcing",
          "concept": "control-systems:forcing-matrix",
          "description": "Forcing matrix.",
          "shape": "matrix",
          "notation": ["Q", "W", "R", "S", "N", "T", "Omega"]
        }
      ],
      "semanticForms": [
        "state-matrix^T certificate + certificate state-matrix = -forcing",
        "state-matrix' certificate + certificate state-matrix = -forcing",
        "0 = state-matrix^T certificate + certificate state-matrix + forcing",
        "forcing = -(state-matrix^T certificate + certificate state-matrix)"
      ],
      "conditions": [
        "All matrices are declared square with a common dimension."
      ],
      "references": [
        "linear-system-theory"
      ]
    }
  ],
  "activationRules": [
    {
      "id": "control-vocabulary",
      "topic": "foundations",
      "patterns": [
        "control system",
        "state-space",
        "state transition",
        "control input",
        "state vector",
        "system matrix",
        "system matrices"
      ],
      "references": [
        "linear-system-theory"
      ]
    }
  ],
  "roles": [],
  "operators": [],
  "references": [
    {
      "id": "linear-system-theory",
      "title": "Linear System Theory and Design",
      "citation": "Chi-Tsong Chen, Linear System Theory and Design, 4th edition, Oxford University Press, 2013."
    }
  ]
}
