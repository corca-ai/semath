{
  "schemaVersion": 3,
  "packId": "control-systems",
  "packVersion": "1.0.0",
  "packKind": "field",
  "namespace": "control-systems",
  "title": "Control systems",
  "description": "State, input, and system-relation semantics gated by explicit vector and matrix declarations.",
  "dependencies": [{ "packId": "linear-algebra", "versionMajor": 1, "requiredCapabilities": ["semath:shape-analysis"] }],
  "capabilities": { "provides": ["control-systems:law-relations", "semath:formula-recognition"], "requires": ["semath:shape-analysis"] },
  "concepts": [
    { "id": "state", "conceptKind": "entity", "title": "System state", "description": "A state vector summarizing the information needed for future evolution.", "parents": [], "references": ["linear-system-theory"] },
    { "id": "control-input", "conceptKind": "entity", "title": "Control input", "description": "An externally selected input to a dynamical system.", "parents": [], "references": ["linear-system-theory"] },
    { "id": "state-transition", "conceptKind": "relation", "title": "Discrete state transition", "description": "A discrete-time linear state update.", "parents": [], "references": ["linear-system-theory"] }
  ],
  "quantityKinds": [],
  "units": [],
  "laws": [
    {
      "id": "discrete-state-transition",
      "title": "Discrete-time state equation",
      "description": "The next state equals the autonomous state transition plus the control-input contribution.",
      "roles": [
        { "id": "next-state", "concept": "control-systems:state", "description": "State at the next discrete index." },
        { "id": "state-matrix", "concept": "linear-algebra:linear-operator", "description": "State-transition matrix." },
        { "id": "current-state", "concept": "control-systems:state", "description": "State at the current discrete index." },
        { "id": "input-matrix", "concept": "linear-algebra:linear-operator", "description": "Map from control input to state increment." },
        { "id": "control-input", "concept": "control-systems:control-input", "description": "Control input at the current discrete index." }
      ],
      "conditions": ["The matrices and vectors use compatible declared dimensions at the same discrete index."],
      "references": ["linear-system-theory"]
    },
    { "id": "continuous-state-equation", "title": "Continuous-time state equation", "description": "The state derivative equals autonomous dynamics plus the input contribution.", "roles": [{ "id": "state", "concept": "control-systems:state", "description": "State vector and its derivative." }, { "id": "state-matrix", "concept": "linear-algebra:linear-operator", "description": "State matrix." }, { "id": "input-matrix", "concept": "linear-algebra:linear-operator", "description": "Input matrix." }, { "id": "control-input", "concept": "control-systems:control-input", "description": "Control input." }], "conditions": ["All declared dimensions are compatible."], "references": ["linear-system-theory"] },
    { "id": "output-equation", "title": "State-space output equation", "description": "The output equals the state and direct-input contributions.", "roles": [{ "id": "output", "concept": "control-systems:state", "description": "Output vector." }, { "id": "output-matrix", "concept": "linear-algebra:linear-operator", "description": "State-to-output matrix." }, { "id": "state", "concept": "control-systems:state", "description": "State vector." }, { "id": "feedthrough-matrix", "concept": "linear-algebra:linear-operator", "description": "Direct feedthrough matrix." }, { "id": "control-input", "concept": "control-systems:control-input", "description": "Control input." }], "conditions": ["All declared dimensions are compatible."], "references": ["linear-system-theory"] },
    { "id": "state-feedback", "title": "Negative state feedback", "description": "The control input equals negative state gain plus a reference input.", "roles": [{ "id": "control-input", "concept": "control-systems:control-input", "description": "Control input." }, { "id": "feedback-gain", "concept": "linear-algebra:linear-operator", "description": "State-feedback gain." }, { "id": "state", "concept": "control-systems:state", "description": "State vector." }, { "id": "reference", "concept": "control-systems:control-input", "description": "Reference input." }], "conditions": ["The feedback and reference channels share the input dimension."], "references": ["linear-system-theory"] },
    { "id": "closed-loop-state-matrix", "title": "Closed-loop state matrix", "description": "The closed-loop state matrix equals the open-loop matrix minus input matrix times feedback gain.", "roles": [{ "id": "closed-loop-matrix", "concept": "linear-algebra:linear-operator", "description": "Closed-loop state matrix." }, { "id": "state-matrix", "concept": "linear-algebra:linear-operator", "description": "Open-loop state matrix." }, { "id": "input-matrix", "concept": "linear-algebra:linear-operator", "description": "Input matrix." }, { "id": "feedback-gain", "concept": "linear-algebra:linear-operator", "description": "State-feedback gain." }], "conditions": ["All declared dimensions are compatible."], "references": ["linear-system-theory"] },
    { "id": "continuous-lyapunov-equation", "title": "Continuous Lyapunov equation", "description": "A transpose-weighted matrix sum equals a negative definite forcing matrix.", "roles": [{ "id": "state-matrix", "concept": "linear-algebra:linear-operator", "description": "State matrix." }, { "id": "certificate", "concept": "linear-algebra:linear-operator", "description": "Lyapunov matrix." }, { "id": "forcing", "concept": "linear-algebra:linear-operator", "description": "Forcing matrix." }], "conditions": ["All matrices are declared square with a common dimension."], "references": ["linear-system-theory"] },
    { "id": "discrete-lyapunov-equation", "title": "Discrete Lyapunov equation", "description": "The one-step Lyapunov difference equals a negative forcing matrix.", "roles": [{ "id": "state-matrix", "concept": "linear-algebra:linear-operator", "description": "State matrix." }, { "id": "certificate", "concept": "linear-algebra:linear-operator", "description": "Lyapunov matrix." }, { "id": "forcing", "concept": "linear-algebra:linear-operator", "description": "Forcing matrix." }], "conditions": ["All matrices are declared square with a common dimension."], "references": ["linear-system-theory"] }
  ],
  "activationRules": [
    { "id": "control-vocabulary", "topic": "foundations", "patterns": ["control system", "state-space", "state transition", "control input"], "references": ["linear-system-theory"] }
