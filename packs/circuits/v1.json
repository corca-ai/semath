      ]
    }
  ],
  "quantityKinds": [],
  "units": [],
  "laws": [
    {
      "id": "ohm-law",
      "title": "Ohm's law",
      "description": "The voltage across a resistive component equals its current multiplied by resistance.",
      "roles": [
        {
          "id": "voltage",
          "concept": "quantities-units:voltage",
          "description": "Voltage across the component.",
          "shape": "scalar"
        },
        {
          "id": "current",
          "concept": "quantities-units:electric-current",
          "description": "Current through the component.",
          "shape": "scalar"
        },
        {
          "id": "resistance",
          "concept": "quantities-units:resistance",
          "description": "Electrical resistance of the component.",
          "shape": "scalar"
        }
      ],
      "conditions": [
        {
          "id": "consistent-references",
          "kind": "sign-convention",
          "subjects": [
            "voltage",
            "current"
          ],
          "evidencePhrases": [
            "consistent sign convention",
            "passive sign convention"
          ],
          "label": "Voltage polarity and current reference direction use a consistent sign convention."
        }
      ],
      "references": [
        "engineering-circuits"
      ],
      "archetype": {
        "id": "binary-product",
        "slots": {
          "result": "voltage",
          "left-factor": "resistance",
          "right-factor": "current"
        }
      }
    },
    {
      "id": "kirchhoff-current-law",
      "title": "Kirchhoff's current law",
      "description": "The signed sum of currents at a node is zero.",
      "roles": [
        {
          "id": "branch-current",
          "concept": "quantities-units:electric-current",
          "description": "A signed current incident on the node.",
          "variadic": true
        }
      ],
      "conditions": [
        {
          "id": "node-current-convention",
          "kind": "sign-convention",
          "subjects": [
            "branch-current"
          ],
          "evidencePhrases": [
            "node convention",
            "junction convention",
            "currents entering the node",
            "currents leaving the node",
            "currents directed into the junction",
            "currents directed away"
          ],
          "label": "All branch-current signs use one node convention."
        }
      ],
      "activationPhrases": [
        "kcl",
        "charge conservation",
        "node current balance",
        "junction current balance",
        "branch current balance",
        "flow groups",
        "current splits",
        "currents satisfy",
        "currents obey",
        "currents balance",
        "terminal currents"
      ],
      "references": [
        "engineering-circuits"
      ],
      "canonicalRelation": "\\sum branch-current = 0"
    },
    {
      "id": "capacitor-current-law",
      "title": "Capacitor current law",
      "description": "Capacitor current equals capacitance times voltage derivative.",
      "roles": [
        {
          "id": "current",
          "concept": "quantities-units:electric-current",
          "description": "Capacitor current.",
          "shape": "scalar",
          "sourceProjection": "head"
        },
        {
          "id": "capacitance",
          "concept": "quantities-units:capacitance",
          "description": "Capacitance.",
          "shape": "scalar"
        },
        {
          "id": "voltage",
          "concept": "quantities-units:voltage",
          "description": "Capacitor voltage.",
          "shape": "scalar",
          "sourceProjection": "head"
        },
        {
          "id": "time",
          "concept": "quantities-units:duration",
          "description": "Time variable.",
          "shape": "scalar"
        }
      ],
      "conditions": [
        {
          "id": "passive-sign-convention",
          "kind": "sign-convention",
          "subjects": [
            "current",
            "voltage"
          ],
          "evidencePhrases": [
            "passive sign convention"
          ],
          "label": "The passive sign convention is used."
        }
      ],
      "references": [
        "engineering-circuits"
      ],
      "canonicalRelation": "current = capacitance \\frac{d voltage}{d time}",
      "representations": [
        "current = -capacitance \\frac{d voltage}{d time}"
      ]
    },
    {
      "id": "inductor-voltage-law",
      "title": "Inductor voltage law",
      "description": "Inductor voltage equals inductance times the current derivative.",
      "roles": [
        {
          "id": "voltage",
          "concept": "quantities-units:voltage",
          "description": "Inductor terminal voltage.",
          "shape": "scalar",
          "sourceProjection": "head"
        },
        {
          "id": "inductance",
          "concept": "quantities-units:inductance",
          "description": "Inductance.",
          "shape": "scalar"
        },
        {
          "id": "current",
          "concept": "quantities-units:electric-current",
          "description": "Inductor current.",
          "shape": "scalar",
          "sourceProjection": "head"
        },
        {
          "id": "time",
          "concept": "quantities-units:duration",
          "description": "Time variable.",
          "shape": "scalar"
        }
      ],
      "conditions": [
        {
          "id": "consistent-references",
          "kind": "sign-convention",
          "subjects": [
            "voltage",
            "current"
          ],
          "evidencePhrases": [
            "passive sign convention",
            "stated sign convention"
          ],
          "label": "The voltage and current reference directions use one stated sign convention."
        }
      ],
      "references": [
        "engineering-circuits"
      ],
      "canonicalRelation": "voltage = inductance \\frac{d current}{d time}",
      "representations": [
        "voltage = -inductance \\frac{d current}{d time}"
      ]
    }
  ],
