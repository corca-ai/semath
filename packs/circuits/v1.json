  "capabilities": { "provides": ["circuits:law-relations", "semath:formula-recognition"], "requires": ["semath:dimensional-analysis", "semath:quantities"] },
  "concepts": [
    { "id": "component", "conceptKind": "entity", "title": "Circuit component", "description": "A component connected between circuit nodes.", "parents": [], "references": ["engineering-circuits"] },
    { "id": "node", "conceptKind": "entity", "title": "Circuit node", "description": "An equipotential connection point in a circuit model.", "parents": [], "references": ["engineering-circuits"] },
    { "id": "ohm-law", "conceptKind": "relation", "title": "Ohm's law", "description": "Voltage across a resistor equals current times resistance.", "parents": [], "references": ["engineering-circuits"] }
  ],
  "quantityKinds": [],
  "units": [],
  "laws": [
    {
      "id": "ohm-law",
      "title": "Ohm's law",
      "description": "The voltage across a resistive component equals its current multiplied by resistance.",
      "roles": [
        { "id": "voltage", "concept": "quantities-units:voltage", "description": "Voltage across the component." },
        { "id": "current", "concept": "quantities-units:electric-current", "description": "Current through the component." },
        { "id": "resistance", "concept": "quantities-units:resistance", "description": "Electrical resistance of the component." }
      ],
      "conditions": ["Voltage polarity and current reference direction use a consistent sign convention."],
      "references": ["engineering-circuits"]
    },
    { "id": "kirchhoff-current-law", "title": "Kirchhoff's current law", "description": "The signed sum of currents at a node is zero.", "roles": [{ "id": "branch-current", "concept": "quantities-units:electric-current", "description": "A signed current incident on the node." }], "conditions": ["All branch-current signs use one node convention."], "references": ["engineering-circuits"] },
    { "id": "kirchhoff-voltage-law", "title": "Kirchhoff's voltage law", "description": "The signed sum of voltages around a loop is zero.", "roles": [{ "id": "branch-voltage", "concept": "quantities-units:voltage", "description": "A signed voltage along the loop." }], "conditions": ["All voltage signs follow one loop orientation."], "references": ["engineering-circuits"] },
    { "id": "capacitor-charge-law", "title": "Capacitor charge law", "description": "Stored charge equals capacitance times voltage.", "roles": [{ "id": "charge", "concept": "quantities-units:electric-charge", "description": "Stored electric charge." }, { "id": "capacitance", "concept": "quantities-units:capacitance", "description": "Capacitance." }, { "id": "voltage", "concept": "quantities-units:voltage", "description": "Capacitor voltage." }], "conditions": ["The voltage and charge reference signs are consistent."], "references": ["engineering-circuits"] },
    { "id": "capacitor-current-law", "title": "Capacitor current law", "description": "Capacitor current equals capacitance times voltage derivative.", "roles": [{ "id": "current", "concept": "quantities-units:electric-current", "description": "Capacitor current." }, { "id": "capacitance", "concept": "quantities-units:capacitance", "description": "Capacitance." }, { "id": "voltage", "concept": "quantities-units:voltage", "description": "Capacitor voltage." }, { "id": "time", "concept": "quantities-units:duration", "description": "Time variable." }], "conditions": ["The passive sign convention is used."], "references": ["engineering-circuits"] },
    { "id": "inductor-voltage-law", "title": "Inductor voltage law", "description": "Inductor voltage equals inductance times current derivative.", "roles": [{ "id": "voltage", "concept": "quantities-units:voltage", "description": "Inductor voltage." }, { "id": "inductance", "concept": "quantities-units:inductance", "description": "Inductance." }, { "id": "current", "concept": "quantities-units:electric-current", "description": "Inductor current." }, { "id": "time", "concept": "quantities-units:duration", "description": "Time variable." }], "conditions": ["The passive sign convention is used."], "references": ["engineering-circuits"] },
    { "id": "capacitor-energy-law", "title": "Capacitor energy", "description": "Stored capacitor energy equals one half capacitance times voltage squared.", "roles": [{ "id": "energy", "concept": "quantities-units:energy", "description": "Stored energy." }, { "id": "capacitance", "concept": "quantities-units:capacitance", "description": "Capacitance." }, { "id": "voltage", "concept": "quantities-units:voltage", "description": "Capacitor voltage." }], "conditions": ["The capacitor is ideal and linear."], "references": ["engineering-circuits"] },
    { "id": "inductor-energy-law", "title": "Inductor energy", "description": "Stored inductor energy equals one half inductance times current squared.", "roles": [{ "id": "energy", "concept": "quantities-units:energy", "description": "Stored energy." }, { "id": "inductance", "concept": "quantities-units:inductance", "description": "Inductance." }, { "id": "current", "concept": "quantities-units:electric-current", "description": "Inductor current." }], "conditions": ["The inductor is ideal and linear."], "references": ["engineering-circuits"] },
    { "id": "electrical-power-law", "title": "Electrical power", "description": "Instantaneous electrical power equals voltage times current.", "roles": [{ "id": "power", "concept": "quantities-units:power", "description": "Instantaneous power." }, { "id": "voltage", "concept": "quantities-units:voltage", "description": "Voltage." }, { "id": "current", "concept": "quantities-units:electric-current", "description": "Current." }], "conditions": ["Voltage and current signs use one power convention."], "references": ["engineering-circuits"] }
  ],
  "activationRules": [
    { "id": "circuit-vocabulary", "topic": "foundations", "patterns": ["electric circuit", "Ohm's law", "resistor", "circuit node"], "references": ["engineering-circuits"] }
