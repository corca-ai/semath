{
  "schemaVersion": 2,
  "packId": "discrete-math",
  "packVersion": "1.0.0",
  "title": "Discrete mathematics, logic, and sets",
  "description": "Recognition-first catalog for set, logical, combinatorial, and graph notation with overloaded forms kept non-actionable.",
  "activationRules": [
    { "id": "vocabulary", "topic": "foundations", "patterns": ["set theory", "combinatorics", "propositional logic", "graph theory", "vertex set", "edge set"], "references": ["concrete-mathematics"] },
    { "id": "discrete-notation", "topic": "notation", "patterns": ["\\subset", "\\in", "\\cup", "\\cap", "\\forall", "\\exists", "\\binom"], "references": ["concrete-mathematics"] }
  ],
  "roles": [
    { "id": "set", "topic": "sets", "description": "An explicitly declared set.", "notation": ["A", "S"], "references": ["concrete-mathematics"] },
    { "id": "graph", "topic": "graphs", "description": "A graph with explicitly declared vertex and edge sets.", "notation": ["G"], "references": ["graph-theory"] }
  ],
  "operators": [{ "id": "cardinality", "topic": "sets", "description": "Cardinality of an explicitly written set expression.", "notation": ["|S|"], "references": ["concrete-mathematics"] }],
  "patterns": [
    { "id": "set-membership", "topic": "sets", "title": "Set membership", "description": "Membership proposition between an element and a set expression.", "descriptionKey": "set-membership", "maturity": "recognition", "matcher": { "primitive": "regex-captures", "expression": "^(.+)\\s*\\\\in\\s*(.+)$" }, "parameters": [{ "id": "element", "constraint": { "kind": "expression" } }, { "id": "set-expression", "constraint": { "kind": "expression" } }], "result": { "kind": "proposition" }, "references": ["concrete-mathematics"] },
    { "id": "subset-relation", "topic": "sets", "title": "Subset relation", "description": "Subset or proper-subset proposition.", "descriptionKey": "subset-relation", "maturity": "recognition", "matcher": { "primitive": "regex-captures", "expression": "^(.+)\\s*\\\\subset(?:eq)?\\s*(.+)$" }, "parameters": [{ "id": "left-set", "constraint": { "kind": "expression" } }, { "id": "right-set", "constraint": { "kind": "expression" } }], "result": { "kind": "proposition" }, "references": ["concrete-mathematics"] },
    { "id": "set-union", "topic": "sets", "title": "Set union", "description": "Union of two explicit set expressions.", "descriptionKey": "set-union", "maturity": "recognition", "matcher": { "primitive": "regex-captures", "expression": "^(.+)\\s*\\\\cup\\s*(.+)$" }, "parameters": [{ "id": "left-set", "constraint": { "kind": "expression" } }, { "id": "right-set", "constraint": { "kind": "expression" } }], "result": { "kind": "set" }, "references": ["concrete-mathematics"] },
    { "id": "set-intersection", "topic": "sets", "title": "Set intersection", "description": "Intersection of two explicit set expressions.", "descriptionKey": "set-intersection", "maturity": "recognition", "matcher": { "primitive": "regex-captures", "expression": "^(.+)\\s*\\\\cap\\s*(.+)$" }, "parameters": [{ "id": "left-set", "constraint": { "kind": "expression" } }, { "id": "right-set", "constraint": { "kind": "expression" } }], "result": { "kind": "set" }, "references": ["concrete-mathematics"] },
    { "id": "set-difference", "topic": "sets", "title": "Set difference", "description": "Elements of one set expression outside another.", "descriptionKey": "set-difference", "maturity": "recognition", "matcher": { "primitive": "regex-captures", "expression": "^(.+)\\s*\\\\setminus\\s*(.+)$" }, "parameters": [{ "id": "left-set", "constraint": { "kind": "expression" } }, { "id": "right-set", "constraint": { "kind": "expression" } }], "result": { "kind": "set" }, "references": ["concrete-mathematics"] },
    { "id": "power-set", "topic": "sets", "title": "Power set", "description": "Set of all subsets of an explicit set expression.", "descriptionKey": "power-set", "maturity": "recognition", "matcher": { "primitive": "regex-captures", "expression": "^\\\\mathcal\\s*\\{P\\}\\s*\\((.+)\\)$" }, "parameters": [{ "id": "set-expression", "constraint": { "kind": "expression" } }], "result": { "kind": "set", "refinements": ["power-set"] }, "references": ["concrete-mathematics"] },
    { "id": "set-cardinality", "topic": "sets", "title": "Set cardinality", "description": "Cardinality of an explicit set expression.", "descriptionKey": "set-cardinality", "maturity": "recognition", "matcher": { "primitive": "regex-captures", "expression": "^\\\\lvert\\s*(.+)\\s*\\\\rvert$" }, "parameters": [{ "id": "set-expression", "constraint": { "kind": "expression" } }], "result": { "kind": "scalar", "refinements": ["nonnegative-integer"] }, "references": ["concrete-mathematics"] },
    { "id": "universal-quantifier", "topic": "logic", "title": "Universal quantifier", "description": "A proposition asserted for every explicitly bound element.", "descriptionKey": "universal-quantifier", "maturity": "recognition", "matcher": { "primitive": "regex-captures", "expression": "^\\\\forall\\s+([^,.:]+)\\s*[,.:]\\s*(.+)$" }, "parameters": [{ "id": "binder", "constraint": { "kind": "expression" } }, { "id": "proposition", "constraint": { "kind": "expression" } }], "result": { "kind": "proposition", "refinements": ["universally-quantified"] }, "references": ["concrete-mathematics"] },
    { "id": "existential-quantifier", "topic": "logic", "title": "Existential quantifier", "description": "A proposition asserting at least one explicitly bound witness.", "descriptionKey": "existential-quantifier", "maturity": "recognition", "matcher": { "primitive": "regex-captures", "expression": "^\\\\exists\\s+([^,.:]+)\\s*[,.:]\\s*(.+)$" }, "parameters": [{ "id": "binder", "constraint": { "kind": "expression" } }, { "id": "proposition", "constraint": { "kind": "expression" } }], "result": { "kind": "proposition", "refinements": ["existentially-quantified"] }, "references": ["concrete-mathematics"] },
    { "id": "logical-implication", "topic": "logic", "title": "Logical implication", "description": "Implication from one explicit proposition to another.", "descriptionKey": "logical-implication", "maturity": "recognition", "matcher": { "primitive": "regex-captures", "expression": "^(.+)\\s*\\\\(?:implies|Rightarrow)\\s*(.+)$" }, "parameters": [{ "id": "premise", "constraint": { "kind": "expression" } }, { "id": "conclusion", "constraint": { "kind": "expression" } }], "result": { "kind": "proposition" }, "references": ["concrete-mathematics"] },
    { "id": "binomial-coefficient", "topic": "combinatorics", "title": "Binomial coefficient", "description": "Number of fixed-size subsets selected from a finite collection.", "descriptionKey": "binomial-coefficient", "maturity": "recognition", "matcher": { "primitive": "regex-captures", "expression": "^\\\\binom\\s*\\{([^{}]+)\\}\\s*\\{([^{}]+)\\}$" }, "parameters": [{ "id": "population-size", "constraint": { "kind": "expression" } }, { "id": "selection-size", "constraint": { "kind": "expression" } }], "result": { "kind": "scalar", "refinements": ["nonnegative-integer"] }, "references": ["concrete-mathematics"] },
    { "id": "linear-recurrence", "topic": "recurrences", "title": "Linear recurrence", "description": "A sequence term defined from an explicit finite linear combination of earlier terms.", "descriptionKey": "linear-recurrence", "maturity": "recognition", "matcher": { "primitive": "regex-captures", "expression": "^([A-Za-z])\\s*_\\s*\\{?([^{}]+)\\}?\\s*=\\s*(.+[A-Za-z]\\s*_\\s*\\{?[^{}]+\\}?.*)$" }, "parameters": [{ "id": "sequence", "constraint": { "kind": "expression" } }, { "id": "index", "constraint": { "kind": "expression" } }, { "id": "recurrence", "constraint": { "kind": "expression" } }], "result": { "kind": "expression", "refinements": ["recurrence"] }, "references": ["concrete-mathematics"] },
    { "id": "graph-degree", "topic": "graphs", "title": "Vertex degree", "description": "Degree of an explicit vertex expression.", "descriptionKey": "graph-degree", "maturity": "recognition", "matcher": { "primitive": "regex-captures", "expression": "^\\\\deg\\s*\\((.+)\\)$" }, "parameters": [{ "id": "vertex", "constraint": { "kind": "expression" } }], "result": { "kind": "scalar", "refinements": ["nonnegative-integer"] }, "references": ["graph-theory"] },
    { "id": "graph-laplacian", "topic": "graphs", "title": "Graph Laplacian", "description": "Graph Laplacian expressed as degree matrix minus adjacency matrix.", "descriptionKey": "graph-laplacian", "maturity": "recognition", "matcher": { "primitive": "regex-captures", "expression": "^([A-Za-z])\\s*=\\s*([A-Za-z])\\s*-\\s*([A-Za-z])$" }, "parameters": [{ "id": "laplacian", "constraint": { "kind": "expression" } }, { "id": "degree-matrix", "constraint": { "kind": "expression" } }, { "id": "adjacency-matrix", "constraint": { "kind": "expression" } }], "result": { "kind": "matrix", "refinements": ["graph-laplacian"] }, "references": ["graph-theory"] }
  ],
  "rewrites": [],
  "references": [
    { "id": "concrete-mathematics", "title": "Concrete Mathematics", "citation": "Ronald L. Graham, Donald E. Knuth, and Oren Patashnik, Concrete Mathematics, 2nd edition, Addison-Wesley, 1994." },
    { "id": "graph-theory", "title": "Graph Theory", "citation": "Reinhard Diestel, Graph Theory, 5th edition, Springer, 2017." }
  ]
}
