{
  "schemaVersion": 3,
  "packId": "calculus-analysis",
  "packVersion": "1.0.0",
  "packKind": "field",
  "namespace": "calculus-analysis",
  "title": "Calculus and analysis",
  "description": "Recognition-first catalog for derivatives, integrals, limits, and series without inferred regularity assumptions.",
  "dependencies": [],
  "capabilities": { "provides": ["semath:formula-recognition"], "requires": [] },
  "concepts": [
    { "id": "function", "conceptKind": "entity", "title": "Function", "description": "A mapping with an explicitly declared domain and codomain.", "parents": [], "references": ["principles-analysis"] },
    { "id": "derivative", "conceptKind": "operator", "title": "Derivative", "description": "A derivative operator with an explicit variable.", "parents": [], "references": ["principles-analysis"] },
    { "id": "integral", "conceptKind": "operator", "title": "Integral", "description": "An integral operator with an explicit integrand and differential.", "parents": [], "references": ["principles-analysis"] }
  ],
  "quantityKinds": [],
  "units": [],
  "laws": [],
  "activationRules": [
    { "id": "vocabulary", "topic": "foundations", "patterns": ["derivative", "integral", "gradient", "Jacobian", "Hessian", "convergence", "Taylor series"], "references": ["principles-analysis"] },
    { "id": "calculus-notation", "topic": "notation", "patterns": ["\\frac{d", "\\partial", "\\int", "\\lim", "\\nabla"], "references": ["principles-analysis"] }
  ],
  "roles": [
    { "id": "function", "topic": "functions", "description": "A function whose domain and codomain are declared by the document.", "notation": ["f", "g"], "references": ["principles-analysis"] }
  ],
  "operators": [
    { "id": "derivative", "topic": "differentiation", "description": "A derivative operator with an explicit variable.", "notation": ["\\frac{d}{dx}", "\\partial"], "references": ["principles-analysis"] },
    { "id": "integral", "topic": "integration", "description": "An integral with explicit integrand, differential, and optional bounds.", "notation": ["\\int"], "references": ["principles-analysis"] }
  ],
  "patterns": [
    { "id": "ordinary-derivative", "topic": "differentiation", "title": "Ordinary derivative", "description": "Derivative of an expression with respect to one variable.", "descriptionKey": "ordinary-derivative", "maturity": "recognition", "matcher": { "primitive": "regex-captures", "expression": "^\\\\frac\\s*\\{\\s*d\\s*([^{}]+)\\s*\\}\\s*\\{\\s*d\\s*([A-Za-z])\\s*\\}$" }, "parameters": [{ "id": "expression", "constraint": { "kind": "expression" } }, { "id": "variable", "constraint": { "kind": "expression" } }], "result": { "kind": "expression", "refinements": ["derivative"] }, "references": ["principles-analysis"] },
    { "id": "partial-derivative", "topic": "differentiation", "title": "Partial derivative", "description": "Partial derivative of an expression with respect to one variable.", "descriptionKey": "partial-derivative", "maturity": "recognition", "matcher": { "primitive": "regex-captures", "expression": "^\\\\frac\\s*\\{\\s*\\\\partial\\s*([^{}]+)\\s*\\}\\s*\\{\\s*\\\\partial\\s*([A-Za-z])\\s*\\}$" }, "parameters": [{ "id": "expression", "constraint": { "kind": "expression" } }, { "id": "variable", "constraint": { "kind": "expression" } }], "result": { "kind": "expression", "refinements": ["partial-derivative"] }, "references": ["principles-analysis"] },
    { "id": "gradient", "topic": "multivariable-calculus", "title": "Gradient", "description": "Gradient notation for a scalar expression.", "descriptionKey": "gradient", "maturity": "recognition", "matcher": { "primitive": "regex-captures", "expression": "^\\\\nabla\\s*([A-Za-z](?:\\s*\\([^)]*\\))?)$" }, "parameters": [{ "id": "expression", "constraint": { "kind": "expression" } }], "result": { "kind": "vector", "refinements": ["gradient"] }, "references": ["principles-analysis"] },
    { "id": "hessian", "topic": "multivariable-calculus", "title": "Hessian", "description": "Second-derivative matrix notation for a scalar expression.", "descriptionKey": "hessian", "maturity": "recognition", "matcher": { "primitive": "regex-captures", "expression": "^\\\\nabla\\s*\\^\\s*\\{?2\\}?\\s*([A-Za-z](?:\\s*\\([^)]*\\))?)$" }, "parameters": [{ "id": "expression", "constraint": { "kind": "expression" } }], "result": { "kind": "matrix", "refinements": ["hessian"] }, "references": ["principles-analysis"] },
    { "id": "laplacian", "topic": "vector-calculus", "title": "Laplacian", "description": "Laplacian applied to an expression.", "descriptionKey": "laplacian", "maturity": "recognition", "matcher": { "primitive": "regex-captures", "expression": "^(?:\\\\Delta|\\\\nabla\\s*\\^\\s*\\{?2\\}?)\\s*([A-Za-z](?:\\s*\\([^)]*\\))?)$" }, "parameters": [{ "id": "expression", "constraint": { "kind": "expression" } }], "result": { "kind": "expression", "refinements": ["laplacian"] }, "references": ["principles-analysis"] },
    { "id": "definite-integral", "topic": "integration", "title": "Definite integral", "description": "Integral with explicit lower and upper bounds and differential.", "descriptionKey": "definite-integral", "maturity": "recognition", "matcher": { "primitive": "regex-captures", "expression": "^\\\\int\\s*_\\s*\\{?([^{}^]+)\\}?\\s*\\^\\s*\\{?([^{}]+)\\}?\\s*(.+)\\s*\\,?\\s*d\\s*([A-Za-z])$" }, "parameters": [{ "id": "lower-bound", "constraint": { "kind": "expression" } }, { "id": "upper-bound", "constraint": { "kind": "expression" } }, { "id": "integrand", "constraint": { "kind": "expression" } }, { "id": "variable", "constraint": { "kind": "expression" } }], "result": { "kind": "expression", "refinements": ["definite-integral"] }, "references": ["principles-analysis"] },
    { "id": "indefinite-integral", "topic": "integration", "title": "Indefinite integral", "description": "Integral with an explicit differential and no bounds.", "descriptionKey": "indefinite-integral", "maturity": "recognition", "matcher": { "primitive": "regex-captures", "expression": "^\\\\int\\s+(.+)\\s*\\,?\\s*d\\s*([A-Za-z])$" }, "parameters": [{ "id": "integrand", "constraint": { "kind": "expression" } }, { "id": "variable", "constraint": { "kind": "expression" } }], "result": { "kind": "expression", "refinements": ["antiderivative-family"] }, "references": ["principles-analysis"] },
    { "id": "limit", "topic": "limits", "title": "Limit", "description": "Limit of an expression along an explicit variable and target.", "descriptionKey": "limit", "maturity": "recognition", "matcher": { "primitive": "regex-captures", "expression": "^\\\\lim\\s*_\\s*\\{\\s*([A-Za-z])\\s*\\\\to\\s*([^{}]+)\\}\\s*(.+)$" }, "parameters": [{ "id": "variable", "constraint": { "kind": "expression" } }, { "id": "target", "constraint": { "kind": "expression" } }, { "id": "expression", "constraint": { "kind": "expression" } }], "result": { "kind": "expression", "refinements": ["limit"] }, "references": ["principles-analysis"] },
    { "id": "infinite-series", "topic": "series", "title": "Infinite series", "description": "A sum with an explicit index and infinite upper bound.", "descriptionKey": "infinite-series", "maturity": "recognition", "matcher": { "primitive": "regex-captures", "expression": "^\\\\sum\\s*_\\s*\\{\\s*([A-Za-z])\\s*=\\s*([^{}]+)\\}\\s*\\^\\s*\\{\\s*\\\\infty\\s*\\}\\s*(.+)$" }, "parameters": [{ "id": "index", "constraint": { "kind": "expression" } }, { "id": "lower-bound", "constraint": { "kind": "expression" } }, { "id": "term", "constraint": { "kind": "expression" } }], "result": { "kind": "expression", "refinements": ["infinite-series"] }, "references": ["principles-analysis"] },
    { "id": "finite-product", "topic": "sequences", "title": "Indexed product", "description": "A product over explicit lower and upper index bounds.", "descriptionKey": "finite-product", "maturity": "recognition", "matcher": { "primitive": "regex-captures", "expression": "^\\\\prod\\s*_\\s*\\{\\s*([A-Za-z])\\s*=\\s*([^{}]+)\\}\\s*\\^\\s*\\{?([^{}]+)\\}?\\s*(.+)$" }, "parameters": [{ "id": "index", "constraint": { "kind": "expression" } }, { "id": "lower-bound", "constraint": { "kind": "expression" } }, { "id": "upper-bound", "constraint": { "kind": "expression" } }, { "id": "term", "constraint": { "kind": "expression" } }], "result": { "kind": "expression", "refinements": ["indexed-product"] }, "references": ["principles-analysis"] },
    { "id": "divergence", "topic": "vector-calculus", "title": "Divergence", "description": "Divergence of a vector-field expression.", "descriptionKey": "divergence", "maturity": "recognition", "matcher": { "primitive": "regex-captures", "expression": "^\\\\nabla\\s*\\\\cdot\\s*([A-Za-z](?:\\s*\\([^)]*\\))?)$" }, "parameters": [{ "id": "field", "constraint": { "kind": "expression" } }], "result": { "kind": "scalar", "refinements": ["divergence"] }, "references": ["principles-analysis"] },
    { "id": "curl", "topic": "vector-calculus", "title": "Curl", "description": "Curl of a vector-field expression.", "descriptionKey": "curl", "maturity": "recognition", "matcher": { "primitive": "regex-captures", "expression": "^\\\\nabla\\s*\\\\times\\s*([A-Za-z](?:\\s*\\([^)]*\\))?)$" }, "parameters": [{ "id": "field", "constraint": { "kind": "expression" } }], "result": { "kind": "vector", "refinements": ["curl"] }, "references": ["principles-analysis"] }
  ],
  "rewrites": [],
  "references": [{ "id": "principles-analysis", "title": "Principles of Mathematical Analysis", "citation": "Walter Rudin, Principles of Mathematical Analysis, 3rd edition, McGraw-Hill, 1976." }]
}
