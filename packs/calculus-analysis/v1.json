  "laws": [
    {
      "id": "first-derivative-relation",
      "title": "First derivative relation",
      "description": "A derivative symbol equals the first derivative of a function with respect to an explicit variable.",
      "roles": [
        {
          "id": "derivative",
          "concept": "calculus-analysis:derivative",
          "description": "First derivative value.",
          "notation": [
            "fprime",
            "g",
            "yprime"
          ]
        },
        {
          "id": "function",
          "concept": "calculus-analysis:function",
          "description": "Differentiated function.",
          "notation": [
            "f",
            "g",
            "y"
          ]
        },
        {
          "id": "variable",
          "concept": "calculus-analysis:variable",
          "description": "Differentiation variable.",
          "notation": [
            "x",
            "t",
            "s"
          ]
        }
      ],
      "conditions": [
        {
          "id": "function-differentiable",
          "kind": "differentiable",
          "subjects": [
            "function",
            "variable"
          ],
          "label": "The function is differentiable with respect to the stated variable."
        }
      ],
      "references": [
        "principles-analysis"
      ],
      "canonicalRelation": "derivative = \\frac{d function}{d variable}"
    },
    {
      "id": "gradient-relation",
      "title": "Gradient relation",
      "description": "A declared gradient equals nabla applied to a function.",
      "roles": [
        {
          "id": "result",
          "concept": "calculus-analysis:nabla-operator",
          "description": "Nabla result.",
          "shape": "vector",
          "sourceProjection": "head"
        },
        {
          "id": "function",
          "concept": "calculus-analysis:function",
          "description": "Differentiated scalar function.",
          "sourceProjection": "head"
        }
      ],
      "conditions": [
        {
          "id": "declared-domain",
          "kind": "domain-membership",
          "subjects": [
            "result",
            "function"
          ],
          "label": "Every role is explicitly bound to its declared semantic domain."
        }
      ],
      "references": [
        "principles-analysis"
      ],
      "canonicalRelation": "result = \\nabla function"
    },
    {
