{
  "name": "semath",
  "version": "0.17.0",
  "private": false,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "bin": {
    "semath-lsp": "./packages/lsp/stdio.mjs",
    "semath-pack": "./packages/authoring/cli.mjs"
  },
  "exports": {
    "./authoring": "./packages/authoring/src/index.ts",
    "./evaluation": "./packages/evaluation/src/index.ts",
    "./lsp": "./packages/lsp/src/index.ts",
    "./protocol": "./packages/protocol/src/index.ts",
    "./wasmtex-adapter": "./packages/wasmtex-adapter/src/index.ts",
    "./worker": "./packages/worker/src/index.ts",
    "./worker-host": "./packages/worker/src/host.ts",
    "./worker-runtime": "./packages/worker/src/runtime.ts",
    "./wasm": "./lib/wasm/semath_wasm.js",
    "./wasm-binary": "./lib/wasm/semath_wasm_bg.wasm"
  },
  "files": [
    "examples",
    "lib",
    "packages",
    "packs",
    "README.md"
  ],
  "scripts": {
    "architecture": "bun scripts/check-architecture.ts",
    "budget": "bun scripts/check-budget.ts",
    "budget:report": "SEMATH_BUDGET_REPORT=.artifacts/performance-budget.json bun scripts/check-budget.ts",
    "budget:scale": "SEMATH_BUDGET_DOCUMENTS=500 SEMATH_BUDGET_DELTA_RUNS=10 bun scripts/check-budget.ts",
    "budget:stable": "SEMATH_BUDGET_STABLE=1 bun scripts/check-budget.ts && SEMATH_BUDGET_STABLE=1 SEMATH_BUDGET_DOCUMENTS=500 SEMATH_BUDGET_DELTA_RUNS=10 bun scripts/check-budget.ts",
    "challenge": "bun scripts/check-challenge.ts",
    "challenge:baseline": "SEMATH_CHALLENGE_ALLOW_FAILURES=1 SEMATH_CHALLENGE_REPORT=.artifacts/recognition-challenge.json bun scripts/check-challenge.ts",
    "challenge:report": "SEMATH_CHALLENGE_REPORT=.artifacts/recognition-challenge.json bun scripts/check-challenge.ts",
    "equivalence:challenge": "bun scripts/check-equivalence-challenge.ts",
    "equivalence:baseline": "SEMATH_EQUIVALENCE_ALLOW_FAILURES=1 SEMATH_EQUIVALENCE_REPORT=.artifacts/equivalence-challenge.json bun scripts/check-equivalence-challenge.ts",
    "domain:challenge": "bun scripts/check-domain-routing-challenge.ts",
    "domain:baseline": "SEMATH_DOMAIN_ALLOW_FAILURES=1 SEMATH_DOMAIN_REPORT=.artifacts/domain-routing-challenge.json bun scripts/check-domain-routing-challenge.ts",
    "domain:fixture": "bun scripts/check-domain-routing-fixture.ts",
    "check": "cargo fmt --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace && bun run typecheck && bun test && bun run architecture && bun run legacy:audit:check && bun run corpus:generate:check && bun run engineering:generate:check && bun run foundation:generate:check && bun run domain:fixture && bun run pack:authoring && bun run pack:conformance && bun run parity && bun run budget && bun run package:smoke",
    "corpus": "bun scripts/check-corpus.ts",
    "corpus:generate": "bun scripts/generate-synthetic-corpus.ts",
    "corpus:generate:check": "bun scripts/generate-synthetic-corpus.ts --check",
    "engineering:generate": "bun scripts/generate-engineering-corpus.ts",
    "engineering:generate:check": "bun scripts/generate-engineering-corpus.ts --check",
    "foundation": "bun scripts/check-foundation.ts",
    "foundation:generate": "bun scripts/generate-foundation-corpus.ts",
    "foundation:generate:check": "bun scripts/generate-foundation-corpus.ts --check",
    "legacy:audit": "bun scripts/audit-legacy-semantic-paths.ts",
    "legacy:audit:check": "bun scripts/audit-legacy-semantic-paths.ts --check",
    "notation:conformance": "bun test packages/evaluation/src/notation-conformance.test.ts",
    "package:smoke": "node scripts/check-package-smoke.mjs",
    "pack:authoring": "bun packages/authoring/cli.mjs validate packs/*/v1.json && bun packages/authoring/cli.mjs audit-runtime packs/*/v1.json",
    "pack:conformance": "bun scripts/check-pack-conformance.ts",
    "parity": "bun scripts/check-parity.mjs && bun scripts/check-lifecycle.mjs",
    "scorecard": "SEMATH_SCORECARD_PATH=.artifacts/semantic-scorecard.json bun scripts/check-corpus.ts",
    "quality": "bun run corpus:generate:check && bun run engineering:generate:check && bun run foundation:generate:check && bun run pack:authoring && bun run pack:conformance && bun run challenge && bun run equivalence:challenge && bun run domain:challenge && bun run corpus && bun run foundation && SEMATH_LIFECYCLE_FULL=1 bun run parity && bun run budget:stable && bun run package:smoke",
    "test": "cargo test --workspace && bun test",
    "typecheck": "tsc --noEmit",
    "verify": "bun run check"
  },
  "dependencies": {
    "wasmtex": "github:corca-ai/wasmtex#2efd5a22b1e2680b7392fcba36cff9471faff62c"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
