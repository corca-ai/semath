{
  "name": "semath",
  "version": "0.8.1",
  "private": false,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "exports": {
    "./protocol": "./packages/protocol/src/index.ts",
    "./wasmtex-adapter": "./packages/wasmtex-adapter/src/index.ts",
    "./worker": "./packages/worker/src/index.ts",
    "./worker-runtime": "./packages/worker/src/runtime.ts",
