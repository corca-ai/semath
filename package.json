{
  "name": "semath",
  "version": "0.14.0",
  "private": false,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "bin": {
    "semath-lsp": "./packages/lsp/stdio.mjs",
    "semath-pack": "./packages/packs/conformance.mjs"
  },
  "exports": {
    "./lsp": "./packages/lsp/src/index.ts",
    "./packs": "./packages/packs/src/index.ts",
    "./protocol": "./packages/protocol/src/index.ts",
    "./wasmtex-adapter": "./packages/wasmtex-adapter/src/index.ts",
    "./worker": "./packages/worker/src/index.ts",
    "./worker-host": "./packages/worker/src/host.ts",
    "./worker-runtime": "./packages/worker/src/runtime.ts",
    "./wasm": "./lib/wasm/semath_wasm.js",
    "./wasm-binary": "./lib/wasm/semath_wasm_bg.wasm"
  },
  "files": [
    "examples",
    "lib",
    "packages",
    "packs",
    "schemas"
  ],
  "scripts": {
    "check": "cargo fmt --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace && bun run typecheck && bun test && bun run pack:conformance && bun run calibration:v0.13 && bun run calibration:v0.14 && bun run corpus:synthetic && bun run parity && bun run budget:v0.8 && bun run budget:v0.9 && bun run budget:v0.10 && bun run budget:v0.11 && bun run budget:v0.12 && bun run package:smoke",
    "budget:v0.8": "node scripts/check-v0.8-budget.mjs",
    "budget:v0.9": "bun scripts/check-v0.9-budget.ts",
    "budget:v0.10": "bun scripts/check-v0.10-budget.ts",
    "budget:v0.11": "bun scripts/check-v0.11-budget.ts",
    "budget:v0.12": "bun scripts/check-v0.12-budget.ts",
    "calibration:v0.11": "bun scripts/check-v0.11-calibration.ts",
    "calibration:v0.12": "bun scripts/check-v0.12-calibration.ts",
    "calibration:v0.13": "bun scripts/check-v0.13-calibration.ts",
    "calibration:v0.14": "bun scripts/check-v0.14-calibration.ts",
    "corpus:synthetic": "bun scripts/check-synthetic-corpus.ts",
    "pack:conformance": "bun packages/packs/conformance.mjs",
    "package:smoke": "node scripts/check-package-smoke.mjs",
    "parity": "node scripts/check-parity.mjs",
    "test": "cargo test --workspace && bun test",
    "typecheck": "tsc --noEmit",
    "update:goldens": "node scripts/update-native-goldens.mjs"
  },
  "dependencies": {
    "wasmtex": "github:corca-ai/wasmtex#7f649bd"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
