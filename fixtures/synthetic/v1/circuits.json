    { "id": "circ-rec-ohm-01", "topic": "resistive-circuits", "purpose": "recognition", "language": "markdown", "source": "Let $V$ be voltage in volts. Let $I$ be electric current in amperes. Let $R$ be resistance in ohms. Ohm's law is $V=I R$.", "cursorNeedle": "V=I R", "expectedPatterns": ["ohm-law"] },
    { "id": "circ-rec-ohm-02", "topic": "resistive-circuits", "purpose": "recognition", "language": "latex", "source": "Let $E$ be voltage. Let $J$ be electric current. Let $Z$ be resistance. Then \\[E=J Z\\]", "cursorNeedle": "E=J Z", "expectedPatterns": ["ohm-law"] },
    { "id": "circ-rec-ohm-03", "topic": "resistive-circuits", "purpose": "recognition", "language": "markdown", "source": "Let $U$ be voltage. Let $i$ be electric current. Let $r$ be resistance. Use $U=i\\cdot r$.", "cursorNeedle": "U=i\\cdot r", "expectedPatterns": ["ohm-law"] },
    { "id": "circ-rec-ohm-04", "topic": "resistive-circuits", "purpose": "recognition", "language": "latex", "source": "$W$ is voltage in volts. $j$ is electric current in amperes. $s$ is resistance in ohms. \\[W=j s\\]", "cursorNeedle": "W=j s", "expectedPatterns": ["ohm-law"] },
    { "id": "circ-rec-ohm-05", "topic": "resistive-circuits", "purpose": "recognition", "language": "markdown", "source": "Let $X$ denote voltage. Let $k$ denote electric current. Let $t$ denote resistance. Check $X=k t$.", "cursorNeedle": "X=k t", "expectedPatterns": ["ohm-law"] },
    { "id": "circ-rec-ohm-06", "topic": "resistive-circuits", "purpose": "recognition", "language": "latex", "source": "Let $Y$ be voltage measured in V. Let $l$ be electric current measured in A. Let $u$ be resistance measured in ohms. \\[Y=l\\cdot u\\]", "cursorNeedle": "Y=l\\cdot u", "expectedPatterns": ["ohm-law"] },
    { "id": "circ-rec-ohm-07", "topic": "resistive-circuits", "purpose": "recognition", "language": "markdown", "source": "Let $Q$ be voltage. Let $m$ be electric current. Let $v$ be resistance. Their relation is $Q=m v$.", "cursorNeedle": "Q=m v", "expectedPatterns": ["ohm-law"] },
    { "id": "circ-rec-ohm-08", "topic": "resistive-circuits", "purpose": "recognition", "language": "latex", "source": "Let $S$ represent voltage in volts. Let $n$ represent electric current in amperes. Let $w$ represent resistance in ohms. \\[S=n w\\]", "cursorNeedle": "S=n w", "expectedPatterns": ["ohm-law"] },
    { "id": "circ-rec-ohm-09", "topic": "resistive-circuits", "purpose": "recognition", "language": "markdown", "source": "Let $T$ be voltage. Let $o$ be electric current. Let $x$ be resistance. Thus $T=o\\cdot x$.", "cursorNeedle": "T=o\\cdot x", "expectedPatterns": ["ohm-law"] },
    { "id": "circ-rec-ohm-10", "topic": "resistive-circuits", "purpose": "recognition", "language": "latex", "source": "Let $A$ be voltage. Let $p$ be electric current. Let $y$ be resistance. \\[A=p y\\]", "cursorNeedle": "A=p y", "expectedPatterns": ["ohm-law"] },
    { "id": "circ-rec-ohm-11", "topic": "resistive-circuits", "purpose": "recognition", "language": "markdown", "source": "Let $B$ be voltage in volts; let $q$ be electric current in amperes; let $z$ be resistance in ohms. Use $B=q z$.", "cursorNeedle": "B=q z", "expectedPatterns": ["ohm-law"] },
    { "id": "circ-rec-ohm-12", "topic": "resistive-circuits", "purpose": "recognition", "language": "latex", "source": "$C$, the voltage, is fixed. $r$, the electric current, is fixed. $D$, the resistance, is fixed. \\[C=r D\\]", "cursorNeedle": "C=r D", "expectedPatterns": ["ohm-law"] },
    { "id": "circ-rec-ohm-13", "topic": "resistive-circuits", "purpose": "recognition", "language": "markdown", "source": "Let $G$ denote voltage. Let $s$ denote electric current. Let $H$ denote resistance. Then $G=s H$.", "cursorNeedle": "G=s H", "expectedPatterns": ["ohm-law"] },
    { "id": "circ-rec-ohm-14", "topic": "resistive-circuits", "purpose": "recognition", "language": "latex", "source": "Let $K$ be voltage. Let $t$ be electric current. Let $L$ be resistance. \\[K=t\\cdot L\\]", "cursorNeedle": "K=t\\cdot L", "expectedPatterns": ["ohm-law"] },
