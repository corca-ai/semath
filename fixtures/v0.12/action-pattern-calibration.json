{
  "cases": [
    {
      "id": "linear-matrix-vector-product",
      "preamble": "$A \\in \\mathbb{R}^{m \\times n}, x \\in \\mathbb{R}^{n}$\n",
      "surfaces": ["$Ax$", "\\[Ax\\]", "$ A \\cdot x $"],
      "expectedPattern": "matrix-vector-product"
    },
    {
      "id": "linear-matrix-matrix-product",
      "preamble": "$A \\in \\mathbb{R}^{m \\times n}, B \\in \\mathbb{R}^{n \\times p}$\n",
      "surfaces": ["$AB$", "\\[AB\\]", "$ A \\cdot B $"],
      "expectedPattern": "matrix-matrix-product"
    },
    {
      "id": "linear-matrix-transpose",
      "preamble": "$A \\in \\mathbb{R}^{m \\times n}$\n",
      "surfaces": ["$A^{\\top}$", "\\[A^\\top\\]", "$ A ^ { \\top } $"],
      "expectedPattern": "matrix-transpose"
    },
    {
      "id": "linear-vector-inner-product",
      "preamble": "$x \\in \\mathbb{R}^{n}, y \\in \\mathbb{R}^{n}$\n",
      "surfaces": ["$x^{\\top}y$", "\\[x^\\top y\\]", "$ x ^ { \\top } y $"],
      "expectedPattern": "vector-inner-product"
    },
    {
      "id": "linear-quadratic-form",
      "preamble": "$M \\in \\mathbb{R}^{n \\times n}, x \\in \\mathbb{R}^{n}$\n",
      "surfaces": ["$x^{\\top}Mx$", "\\[x^\\top Mx\\]", "$ x ^ { \\top } M x $"],
      "expectedPattern": "quadratic-form"
    },
    {
      "id": "probability-event-probability",
      "preamble": "Let $A$ denote an event.\n",
      "surfaces": ["$\\mathbb{P}(A)$", "$\\Pr(A)$", "$\\mathrm{P}\\left(A\\right)$"],
      "expectedPattern": "event-probability"
    },
    {
      "id": "probability-conditional-probability",
      "preamble": "Let $A$ denote an event.\nLet $B$ denote an event of positive probability.\n",
      "surfaces": ["$\\mathbb{P}(A \\mid B)$", "$\\Pr(A|B)$", "$\\mathrm{P}\\left(A \\vert B\\right)$"],
      "expectedPattern": "conditional-probability"
    },
    {
      "id": "probability-expectation",
      "preamble": "Let $X$ denote a random variable.\n",
      "surfaces": ["$\\mathbb{E}[X]$", "$\\mathrm{E}[X]$", "$\\mathbb{E}\\left[X\\right]$"],
      "expectedPattern": "expectation"
    },
    {
      "id": "probability-variance",
      "preamble": "Let $X$ denote a random variable.\n",
      "surfaces": ["$\\operatorname{Var}(X)$", "$\\mathrm{Var}(X)$", "$\\operatorname{Var}\\left(X\\right)$"],
      "expectedPattern": "variance"
    }
  ]
}
